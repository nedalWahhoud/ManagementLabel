@page "/discountcode"

<div class="p-2" @onclick="OnMainDiv">
    <AuthorizeView>
        <Authorized Context="authContext">
            @if (isLoading)
            {
                @if (authContext.User.HasClaim("permission", "manageDiscounts") || authContext.User.HasClaim("permission", "fullAccess"))
                {
                    <div class="addFormBtn">
                        <button class="btn btn-primary" @onclick="() => OpenAddForm(true,true)">Neuen Rabattcode hinzufügen</button>
                        <button class="btn btn-success" @onclick="() => OpenAddForm(false,true)">Neuen Category Rabattcode hinzufügen</button>
                    </div>

                    @* table discount codes *@
                    <div class="tableResponsive">
                        <table class="table discountTable">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Discount</th>
                                    <th>Usage</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in discountService.DownloadedDiscountCodes)
                                {
                                    DateTime now = DateTime.Now;

                                    var isActiveNow = item.IsActive
                                    && item.StartDate <= now
                                    && item.EndDate >= now;
                                    <tr @key="item.Id"
                                    @oncontextmenu:preventDefault="true"
                                    @oncontextmenu="@(e => OnSelectRow(item,null!, e))"
                                    @onclick="(e) => OnSelectRow(item,null!, e)"
                                    @ondblclick="(e) => OnDoubleTap(item,null!, e)"

                                    class="@(isActiveNow ? "bg-success text-white" : "bg-danger text-white")">
                                        <td>@item.Code</td>
                                        <td>@item.DiscountPercentage %</td>
                                        <td>@item.TimesUsed / @item.UsageLimit</td>
                                        <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                                        <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                                        <td>@item.IsActive</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @* table discount category *@
                    <div class="table-responsive">
                        <table class="table discountTable">
                            <thead>
                                <tr>
                                    <th>Kategore</th>
                                    <th>Code</th>
                                    <th>Discount</th>
                                    <th>Usage</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in discountService.DownloadedDiscountCategory)
                                {
                                    DateTime now = DateTime.Now;

                                    var isActiveNow = item.IsActive
                                    && item.StartDate <= now
                                    && item.EndDate >= now;
                                    <tr @key="item.Id"
                                    @oncontextmenu:preventDefault="true"
                                    @oncontextmenu="@(e => OnSelectRow(null!,item, e))"
                                    @onclick="(e) => OnSelectRow(null!,item, e)"
                                    @ondblclick="(e) => OnDoubleTap(null!,item, e)"
                                    class="@(isActiveNow ? "bg-success text-white" : "bg-danger text-white")">
                                        <td>@(item.Category != null ? item.Category.Name_de : "Fehler")</td>
                                        <td>@item.Code</td>
                                        <td>@item.DiscountPercentage %</td>
                                        <td>@item.TimesUsed / @item.UsageLimit</td>
                                        <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                                        <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                                        <td>@item.IsActive</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>


                    @* menu context *@
                    @if (showContextMenu && (selectedRowDiscountCodes != null || selectedRowDiscountCategory != null))
                    {
                        <div class="contextMenu dropdown-menu-end dropdown-menu"
                        style="position: fixed; top: @(menuY!)px; left: @(menuX!)px; display: block;"
                        @onclick:stopPropagation="true">
                            <ul>
                                <li @onclick="() => Edit(selectedRowDiscountCodes!,selectedRowDiscountCategory!)">
                                    <a><i class="fa-solid fa-pen-to-square"></i> Bearbeiten</a>
                                </li>
                                <li @onclick="() => Delete(selectedRowDiscountCodes!,selectedRowDiscountCategory!)">
                                    <a><i class="fa-solid fa-trash-can"></i> Löschen</a>
                                </li>
                            </ul>
                        </div>
                    }
                }
                else
                {
                    <div style="display:flex; justify-content:center; align-items:center; height:80vh;">
                        <div class="alert alert-danger text-center">
                            Sie haben keine Berechtigung für diese Seite
                        </div>
                    </div>
                }
                @if (showDiscountFormAction != null)
                {
                    if (showDiscountFormAction.Value.ifAdd)
                    {
                        <ManagementLabel.Components.Layout.OverlayEditAddDiscount discountCode="newDiscountCode" discountCategory="newDiscountCategory" action="showDiscountFormAction.Value" OnHandel="HandleAddEditDiscount" />
                    }
                    else
                    {
                        <ManagementLabel.Components.Layout.OverlayEditAddDiscount discountCode="editDiscountCode" discountCategory="editDiscountCategory" action="showDiscountFormAction.Value" OnHandel="HandleAddEditDiscount" />
                    }
                }
            }
            else
            {
                <div style="display:flex; justify-content:center; align-items:center; height:80vh;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <ManagementLabel.Components.Pages.LogIn />
        </NotAuthorized>
    </AuthorizeView>
</div>
@code {

    private bool isLoading = false;
    protected override async Task OnInitializedAsync()
    {
        var authState = await authProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var canViewCoupons = user.HasClaim("permission", "manageDiscounts") ||
                             user.HasClaim("permission", "fullAccess");
        if (canViewCoupons)
        {
            // get Discount codes
            await discountService.GetAllDiscountCodes();
            // get Discount Categorys
            await discountService.GetAllDiscountCategory();
        }
        isLoading = true;
    }

    private (bool ifdicountCode, bool ifAdd)? showDiscountFormAction;
    private void OpenAddForm(bool ifDiscountCode,bool ifAdd)
    {
        showDiscountFormAction = (ifDiscountCode, ifAdd);
    }

    private void Edit(DiscountCodes discountCodes, DiscountCategory discountCategory)
    {
        if (discountCodes != null)
        {
            editDiscountCode = new DiscountCodes
                {
                    Id = discountCodes.Id,
                    Code = discountCodes.Code,
                    DiscountPercentage = discountCodes.DiscountPercentage,
                    UsageLimit = discountCodes.UsageLimit,
                    StartDate = discountCodes.StartDate,
                    EndDate = discountCodes.EndDate,
                    IsActive = discountCodes.IsActive,
                };
            OpenAddForm(true, false);
        }
        else if (discountCategory != null)
        {
            editDiscountCategory = new DiscountCategory
                {
                    Id = discountCategory.Id,
                    Code = discountCategory.Code,
                    DiscountPercentage = discountCategory.DiscountPercentage,
                    UsageLimit = discountCategory.UsageLimit,
                    StartDate = discountCategory.StartDate,
                    EndDate = discountCategory.EndDate,
                    IsActive = discountCategory.IsActive,
                    CategoriesId = discountCategory.CategoriesId,
                };
            OpenAddForm(false, false);
        }

        showContextMenu = false;
    }
    private async Task Delete(DiscountCodes discountCodes, DiscountCategory discountCategory)
    {
        var resultConfirm = await JS.InvokeAsync<bool>("confirm", $"Möchten Sie das Discount mit der Code {discountCodes?.Code ?? discountCategory?.Code} wirklich löschen?");
        if (resultConfirm)
        {

            if (discountCodes != null)
            {
                var result = await discountService.DeleteDiscountCode(discountCodes.Id);
                if (result.Result)
                    StateHasChanged();
                else
                    await JS.InvokeVoidAsync("window.alert", result.Message!);
            }
            else if (discountCategory != null)
            {
                var result = await discountService.DeleteDiscountCategory(discountCategory.Id);
                if (result.Result)
                    StateHasChanged();
                else
                    await JS.InvokeVoidAsync("window.alert", result.Message!);

            }
        }
        showContextMenu = false;
    }
    // select DiscountCategory
    private DiscountCategory? selectedRowDiscountCategory;
    // select DiscountCodes
    private DiscountCodes? selectedRowDiscountCodes;
    private void OnDoubleTap(DiscountCodes item,DiscountCategory item1, MouseEventArgs e)
    {
        /*if (_editProduct != null || IsShowAddProductForm || IsDeleting || IsShowInvoice || IsShowOrder)
            return;*/

        selectedRowDiscountCodes = item;
        selectedRowDiscountCategory = item1;

        menuX = e.ClientX;
        menuY = e.ClientY;
        showContextMenu = true;

        StateHasChanged();
    }

    private void OnSelectRow(DiscountCodes item,DiscountCategory item1, MouseEventArgs e)
    {
        /*if (_editProduct != null || IsShowAddProductForm || IsDeleting || IsShowInvoice || IsShowOrder)
            return;*/

        if (e.Button == 2)
        {
            selectedRowDiscountCodes = item;
            selectedRowDiscountCategory = item1;
            menuX = e.ClientX;
            menuY = e.ClientY;
            showContextMenu = true;
        }


    }

    // Menu recht klicken
    private bool showContextMenu = false;
    private double menuX;
    private double menuY;
    private string menuXpx => $"{menuX}px";
    private string menuYpx => $"{menuY}px";

    //
    private DiscountCodes newDiscountCode = new();
    private DiscountCategory newDiscountCategory = new();
    private DiscountCodes editDiscountCode = new();
    private DiscountCategory editDiscountCategory = new();
    private void HandleAddEditDiscount(string Action)
    {
        showDiscountFormAction = null;
    }

    private void OnMainDiv()
	{
		// hide die Menu if sichtbar
		showContextMenu = false;
	}

    
}
