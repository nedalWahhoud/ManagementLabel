	// Delete Product
	private bool IsDeleting = false;
	private async Task DeleteProduct(Products SelectedProduct)
	{
		if (SelectedProduct == null || IsDeleting)
		{
			await JS.InvokeVoidAsync("alert", "Please select a product");
			return;
		}
		// hide die context menu
		showContextMenu = false;
		// set deleting state
		IsDeleting = true;
		var resultConfirm = await JS.InvokeAsync<bool>("confirm", $"Möchten Sie das Produkt mit der ID {SelectedProduct.Id} wirklich löschen?");
		if (resultConfirm)
		{

			var result = await productService.DeleteProductAsync(SelectedProduct.Id);
			if (result.Result)
			{
				productService.DownloadedProduct.RemoveAll(p => p.Id == SelectedProduct.Id);
				// wenn in filter mode
				if (filterP != null && filterP.Count > 0)
				{
					filterP.RemoveAll(p => p.Id == SelectedProduct.Id);
				}
				selectedRow = null;
				await JS.InvokeVoidAsync("alert", result.Message ?? "Message ist Null");
			}
			else
			{
				await JS.InvokeVoidAsync("alert", result.Message ?? "Message ist Null");
			}
		}
		else
		{
			// User cancelled the deletion
		}

		// reset deleting state
		IsDeleting = false;
	}
