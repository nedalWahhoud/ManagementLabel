	private int selectedCategoryId = 0;
	private async Task OnCategoryChanged()
	{
		// show loadingmessage while loading
		IsLoadingMessage = true;
		// reset values filter
		selectedValuesFilter = 0;

		if (selectedCategoryId == 0)
		{
			// if selectedId is 0, clear the filter
			filterP = null!;
		}
		else
		{
			// get excludeProductsIds, from local products
			List<int> excludeProductsIds = productService.DownloadedProduct.Where(f => f.CategoryId == selectedCategoryId)
					.Select(f => f.Id)
					.ToList();

			GetItems<Products> getItems = new();
			// do th filterP not null, to make the complete downloaded products disappear, and only isloadingMessage to show
			filterP = new();
			while (!getItems.AllItemsLoaded)
			{

				Task.Delay(100).Wait(); // wait for a short time before searching again
				getItems = await categoryService.GetProductsByCategoryIdAsync(selectedCategoryId, 10, excludeProductsIds);
				// get downloaded productsIds, to exclude them from the next search
				excludeProductsIds.AddRange(getItems.Items
					.Where(p => p.CategoryId == selectedCategoryId)
					.Select(p => p.Id));
				// initialize CartItem for each product
				foreach (var product in getItems.Items)
				{
					product.InitializeCartItem(cartService.GetQuantityOfProduct(product.Id));
				}
			}
			// get the products by categoryId local, after downloading from server
			filterP = productService.GetProductByCategoryIdLocal(selectedCategoryId);
		}

		// save the selected category id in local storage
		await LocalStorage.SetItemAsync("selectedCategoryId", selectedCategoryId);
		IsLoadingMessage = false;
	}
	// filter nach Lagerbestand
	private int selectedValuesFilter = 0;
	private async Task OnStockFilterChanged()
	{
		IsLoadingMessage = true;

		// reset category filter
		selectedCategoryId = 0;

		if (selectedValuesFilter == 1)
		{
			// get excludeProductsIds nur ein mal, von local products, damit die produkte die schon in local sind, nicht nochmal in der nächsten suche kommen
			List<int> excludeProductsIds = productService.DownloadedProduct
					.Where(p => p.Quantity <= p.MinimumStock)
					.Select(f => f.Id)
					.ToList();
			GetItems<Products> getItems = new();
			// do th filterP not null, to make the complete downloaded products disappear, and only isloadingMessage to show
			filterP = new();


			while (!getItems.AllItemsLoaded)
			{
				await Task.Delay(100); // wait for a short time before searching again

				// get locale products, nur ein mal wenn currentPage 0 ist dann ist sicher erstmal loop.
				//  hier weil ist nach await um "lädt..." zeigen zulassen, damit nicht direkt die produkte die in local sind zeigen
				if (getItems.CurrentPage == 0)
					filterP.AddRange(productService.DownloadedProduct.Where(p => p.Quantity <= p.MinimumStock).ToList());

				var result = await productService.GetProductsLowStockAsync(getItems, excludeProductsIds);

				if (result == null || result.Items == null) break;



				getItems = result;

				// initialize CartItem for each product
				foreach (var product in getItems.Items)
				{
					product.InitializeCartItem(cartService.GetQuantityOfProduct(product.Id));
					filterP.Add(product);
				}
			}
			filterP = filterP.OrderBy(p => p.Name_de).ToList();
		}
		else
		{
			filterP = null!;
		}

		IsLoadingMessage = false;
	}
