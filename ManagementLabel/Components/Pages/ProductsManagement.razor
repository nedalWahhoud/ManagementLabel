	private async Task OnInvoiceGenerate()
	{
		// address
		// add user id, if gust than set it to null
		if (user?.Id > 0)
			newAddress.UserId = user.Id;

		var result = await addressService.AddAddressAsync(newAddress);
		if (result.Result)
		{
			newAddress = addressService.DownloadedAddresses[0]; // Set the selected address  to the new added address
		}
		else
		{
			_ = JS.InvokeVoidAsync("alert", result.Message);
			return;
		}
		// oder
		Order createOrder = new Order()
			{
				DeliveryAddressId = newAddress.Id,
				PaymentMethodId = selectedPaymentId,
				StatusId = 1, // in database 1 = Order Pending
				OrderItems = cartService.CartItems.Select(item => new OrderItems
				{
					ProductId = item.ProductId,
					Quantity = item.Quantity,
					UnitPrice = item.Product?.SalePrice ?? 0
				}).ToList(),
				TotalPrice = order.TotalPrice,
				OrderDate = DateTime.Now,
				Notes = order.Notes,
				UserId = user?.Id ?? 0,
				DiscountCodeId = order.DiscountCodeId ?? null,
				DiscountCategoryId = order.DiscountCategoryId ?? null,
				ShippingProviderId = order.ShippingProviderId ?? null,
				IsUserCreated = false
			};
		var result1 = await orderService.AddOrderAsync(createOrder);
		if (result1.Result)
		{
			// get added order
			order = orderService.DownloadedOrders[orderService.DownloadedOrders.Count - 1];
			// get the products for the order items
			foreach (var item in order.OrderItems)
			{
				item.Product = productService.GetProductByIdLocal(item.ProductId) ?? await productService.GetProductByIdAsync(item.ProductId);
			}
			// set the address of the order
			order.Address = newAddress;
			// add the discount code to the order
			if (order.DiscountCodeId != null && order.DiscountCodeId > 0)
			{
				order.DiscountCode = discountCode;
			}
			else if(order.DiscountCategoryId != null && order.DiscountCategoryId > 0)
			{
				order.DiscountCategory = discountCategory;
			}

			// Rechnung
			order.ShippingProviders = orderService.GetShippingProviderByIdLocal(order.ShippingProviderId ?? 0);
			order.PaymentMethod = orderService.GetPaymentMethodByIdLocal(order.PaymentMethodId);
			invoice = new Invoice
				{
					projectInfo = projectInfo,
					InvoceeNumber = order.OrderDate.Year.ToString() +
												   order.OrderDate.Month.ToString("D2") +
												   order.OrderDate.Day.ToString("D2") +
												   order.Id.ToString("D6"),
					order = order,
				};

			IsInvoiceVisible = true;
			IsShowOrder = false;
			// clear cart
			cartService.ClearCart();
			// clear the newaddress
			newAddress = new()!;
			selectedAddress = false;;
			order = new();
			// default payment id
			selectedPaymentId = 0;
		}
		else
		{
			_ = JS.InvokeVoidAsync("alert", result1.Message);
			return ;
		}
	}
