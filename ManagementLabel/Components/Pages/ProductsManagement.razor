@page "/"
@using ManagementLabel.ProductsF;
@using ManagementLabel.Model;
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@rendermode InteractiveServer

<div @onclick="OnMainDiv">
	<AuthorizeView>
		<Authorized Context="authContext">
			<!-- user info -->
			<p class="userInfo">
				<span class="userName">User Name: @authContext.User.Identity!.Name</span>
			</p>
			@* top continer *@
			<div class="TopContiner">
				<button class="@(!IsShowAddProductForm ? "btn addProductTopB" : "btn addProductCancelB")" @onclick="ShowAddProductFormAsync" disabled="@(IsLoadingMessage)">
					@(!IsShowAddProductForm ? "Produkt hinzufügen" : "Hinzufügen Abbrechen")
				</button>
				<button class="@(!IsShowInvoice ? "btn InvoiceB" : "btn InvoiceCancelB")" @onclick="@(IsShowInvoice ? CancelOrderForm : ShowOrderForm)" disabled="@(IsLoadingMessage)">
					@(!IsShowInvoice ? "Rechnung erstellen" : "Rechnung Abbrechen")
				</button>
				<div class="searchWrapper">
					<input id="searchBox" type="text" placeholder="Searching..." class="searchInput" @oninput="OnTextChanged" disabled="@(IsLoadingMessage || productService.DownloadedProduct.Count == 0)" />
					<button class="clearButton" @onclick="ClearInput" disabled="@(IsLoadingMessage || productService.DownloadedProduct.Count == 0)">
						X
					</button>
				</div>
				@* category filter *@
				<select class="categoryDropdown" @onfocus="OnCategoryOpened" @onchange="OnCategoryChanged" disabled="@(IsLoadingMessage || productService.DownloadedProduct.Count == 0)">
					<option value="0">Alle</option>
					@foreach (var category in categoryService.DownloadedCategories)
					{
						<option value="@category.Id">@category.Name_de</option>
					}
				</select>
			</div>
			@* choose the Columns *@
			<div class="mb-3">
				<div class="dropdown">
					<button class="btn btn-info dropdown-toggle" type="button" data-bs-toggle="dropdown">
						Wähle Spalten
					</button>
					<ul class="dropdown-menu p-3" style="max-height:300px; overflow-y:auto; min-width: 250px;">
						@foreach (var col in columnOptions)
						{
							<li>
								<div class="form-check form-switch">
									<input class="form-check-input"
									type="checkbox"
									id="@col.Key"
									@bind="col.IsVisible"
									@bind:after="OnColumnChanged" />
									<label class="form-check-label" for="@col.Key">
										@col.Label
									</label>
								</div>
							</li>
						}
					</ul>
				</div>
			</div>

			@* table *@
			<div tabindex="0"  @onkeydown="KeyDown" id="scrollContainer" class="tableContiner">

				<table class="table text-center align-middle">
					<thead>
						<tr>
							@if (ShowColumn("Index")) {<th>Index</th>}
							@if (ShowColumn("Id"))	{<th>Id</th>}
							@if (ShowColumn("Name_de")){<th>Name de</th>}
							@if (ShowColumn("Description_de")){<th>Beschreibung de</th>}
							@if (ShowColumn("Name_ar")){<th>Name ar</th>}
							@if (ShowColumn("Description_ar")){<th>Beschreibung ar</th>}
							@if (ShowColumn("Category")){<th>Kategorie</th>}
							@if (ShowColumn("Barcode")){<th>Barcode</th>}
							@if (ShowColumn("Quantity")){<th>Menge</th>}
							@if (ShowColumn("PurchasePrice")){<th>Kaufpreis</th>}
							@if (ShowColumn("SellePrice")){<th>Verkaufspreis</th>}
							@if (ShowColumn("MinimumStock")){<th>Mindestbestand</th>}
							@if (ShowColumn("ExpDate")){<th>Ablaufdatum</th>}
							@if (ShowColumn("Manufacturer")){<th>Hersteller</th>}
							@if (ShowColumn("TaxRate")){<th>Steuersatz</th>}
							@if (ShowColumn("Group")){<th>Gruppe</th>}
							@if (ShowColumn("IsShippable")){<th>Versandfähig</th>}
							@if (ShowColumn("DiscountedPrice")){<th>Im Angebot</th>}
							@if (ShowColumn("Username")){<th>Benutzername</th>}
							@if (ShowColumn("Img")){<th>Img</th>}
							<th class="@(authContext.User.IsInRole("admin") && IsShowInvoice ? "" : "hidden" )"><button class="btn InvoiceGeB" @onclick="OnOrderGenerate">Order erstellen</button></th>
						</tr>
					</thead>
					<tbody>
						@* Loading message *@
						<tr id="loadingMessage" class="@(!IsLoadingMessage ? "hidden" : "show")">
							<td colspan="11" class="loadingMessage">
								Lädt...
							</td>
						</tr>
						@* table *@
						@{
							List<Products> htmlProducts = null!;
							if (filterP == null)
								htmlProducts = productService.DownloadedProduct;
							else
								htmlProducts = filterP;
							if (htmlProducts.Count > 0)
							{
								for (int i = 0; i < htmlProducts.Count; i++)
								{
									Products thisProducts = htmlProducts[i];
									<tr
									@oncontextmenu:preventDefault="true"
									@oncontextmenu="@(e => OnSelectRow(thisProducts, e))"
									@onpointerdown="(e) => OnTouchStart(thisProducts, e)"
									@onpointermove="OnTouchMove"
									@onpointerup="OnTouchEnd"
									@onclick="(e)=> OnSelectRow(thisProducts,e)"
									class="@(selectedRow != null && selectedRow.Id == thisProducts.Id ? "selected" : "")">
										@if (ShowColumn("Index")){<td>@(startIndex + i + 1)</td>}
										@if (ShowColumn("Id")){<td>@htmlProducts[i].Id</td>}
										@if (ShowColumn("Name_de")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Name_de</td>}
										@if (ShowColumn("Description_de")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Description_de</td>}
										@if (ShowColumn("Name_ar")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Name_ar</td> }
										@if (ShowColumn("Description_ar")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Description_ar</td>}
										@if (ShowColumn("Category")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Category!.Name_de</td>}
										@if (ShowColumn("Barcode")) { <td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Barcode</td> }
										@if (ShowColumn("Quantity")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;" class="@(htmlProducts[i].MinimumStock >= htmlProducts[i].Quantity ? "IsMinimumStock" : "")">@htmlProducts[i].Quantity</td>}
										@if (ShowColumn("PurchasePrice")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].PurchasePrice.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>}
										@if (ShowColumn("SellePrice")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].SalePrice.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>}
										@if (ShowColumn("MinimumStock")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].MinimumStock</td>}
										@if (ShowColumn("ExpDate"))
										{
											@* check exp date *@
											var expDate = htmlProducts[i].EXPDate;
											string backgroundcolor = ""; // Default color
											string color = "";

											if (expDate < DateTime.Today)
											{
												backgroundcolor = "red"; // Abgelaufen
												color = "white";
											}
											else if (expDate <= DateTime.Today.AddMonths(1))
											{
												backgroundcolor = "orange"; // Weniger als ein Monat übrig
												color = "white";
											}

											<td style="max-width: 200px; word-wrap: break-word; white-space: normal; background-color:@backgroundcolor; color:@color;">@(expDate!.ToString("dd.MM.yyyy")!)</td>
										}
										@if (ShowColumn("Manufacturer")){<td style="max-width: 100px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Manufacturer!.Name</td>}
										@if (ShowColumn("TaxRate")) {<td style="max-width: 100px; word-wrap: break-word; white-space: normal;">@((htmlProducts[i].TaxRate?.Rate.ToString("0") + "%") ?? "")</td>}
										@if (ShowColumn("Group")) {<td style="max-width: 100px; word-wrap: break-word; white-space: normal;">@(htmlProducts[i].ProductGroup?.GroupName_de ?? "")</td>}
										@if (ShowColumn("IsShippable")){<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].IsShippable</td>}
										@if (ShowColumn("DiscountedPrice")){<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].DiscountedPrice</td>}
										@if (ShowColumn("Username")){<td style="max-width: 100px; word-wrap: break-word; white-space: normal;">@(htmlProducts[i].User?.UserName ?? "")</td>}
										@if (ShowColumn("Img"))
										{
											<td><img src="@productImagesService.GetProductImageUrl(htmlProducts[i].ProductImages?.FirstOrDefault(img => img.IsMain)!)" class="productImg" /></td>
										}
										@* Rechnung *@
										<td class="@(authContext.User.IsInRole("admin") && IsShowInvoice ? "AddDecresaseCard" : "hidden")">
											<ManagementLabel.Components.Layout.AddDecresaseCard ProductId="@thisProducts.CartItem.ProductId" OnQuantityChanged="HandleQuantityChanged" />
										</td>
									</tr>
								}
							}
							else if(!IsLoadingMessage&&startIndex==0)
							{
								<tr>
									<td colspan="11" class="loadingMessage">
										Keine Bestellungen gefunden.
									</td>
								</tr>
							}
							@if (showContextMenu && selectedProduct != null)
							{
								<div class="contextMenu"
								style="position: fixed; top:@menuYpx; left:@menuXpx;"
								@onclick:stopPropagation="true">
									<ul>
										<li @onclick="() => EditProduct(selectedProduct)">✏️ Bearbeiten</li>
										<li @onclick="() => DeleteProduct(selectedProduct)">🗑️ Löschen</li>
									</ul>
								</div>
							}

							htmlProducts = null!;
						}
					</tbody>
				</table>
			</div>

			@* Add Product form *@
			@if (IsShowAddProductForm)
			{
				<ManagementLabel.Components.Layout.OverlayEditForm Action="Add" Title="Ein neues Produkt hinzufügen" ButtonName="Produkt hinzufügen" GetProducts="newProduct" user ="user" OnHandel="HandleEditProduct" />
			}
			else if (_editProduct != null)
			{
				<ManagementLabel.Components.Layout.OverlayEditForm Action="Edit" Title="Produkt bearbeiten" ButtonName="Produkt Updaten" GetProducts="_editProduct" user="user" OnHandel="HandleEditProduct" />
			}
			@* order erstellen *@
			@if (IsShowOrder)
			{
				<div class="overlay">
					<div class="overlayAddForm">
						@* address *@
						<h3>Lieferadresse: </h3>
						@if (selectedAddress == false)
						{
							<EditForm Model="@newAddress" OnValidSubmit="HandleAddressSubmit">
								<DataAnnotationsValidator />
								<div class="form-group">
									<label>Vorname</label>
									<InputText class="form-control" @bind-Value="newAddress.FirstName" />
									<ValidationMessage style="color:red;" For="@(() => newAddress.FirstName)" />
								</div>
								<div class="form-group">
									<label>Nachname</label>
									<InputText class="form-control" @bind-Value="newAddress.LastName" />
									<ValidationMessage style="color:red;" For="@(() => newAddress.LastName)" />
								</div>
								<div class="form-group">
									<label>Tel.</label>
									<InputText class="form-control" @bind-Value="newAddress.Phone" />
									<ValidationMessage style="color:red;" For="@(() => newAddress.Phone)" />
								</div>
								<div class="form-group">
									<label>Straße</label>
									<InputText class="form-control" @bind-Value="newAddress.Street" />
									<ValidationMessage style="color:red;" For="@(() => newAddress.Street)" />
								</div>
								<div class="form-group">
									<label>Postleitzahl</label>
									<InputText class="form-control" @bind-Value="newAddress.ZipCode" />
									<ValidationMessage style="color:red;" For="@(() => newAddress.ZipCode)" />
								</div>
								<div class="form-group">
									<label>Stadt</label>
									<InputText class="form-control" @bind-Value="newAddress.City" />
									<ValidationMessage style="color:red;" For="@(() => newAddress.City)" />
								</div>
								<div class="form-group">
									<label>Land</label>
									<InputText class="form-control" @bind-Value="newAddress.Country" readonly />
								</div>
								<div class="addAddressClassB">
									<button type="submit" class="btn addAddressB">Adresse Hinzufügen</button>
								</div>
							</EditForm>
						}
						@if (selectedAddress == true)
						{
							<InputRadioGroup @bind-Value="selectedAddressId" class="addressRadio">
								<div class="addressOption">
									<label>
										<InputRadio Value="@newAddress.Id" />
										@newAddress.FirstName @newAddress.LastName - @newAddress.Street, @newAddress.ZipCode @newAddress.City
									</label>
								</div>
							</InputRadioGroup>
						}
						@* Zahlung Methode *@
						<div class="paymentMethodOption">
							<InputRadioGroup Value="@selectedPaymentId" ValueChanged="@((int val) => OnPaymentChanged(val))" ValueExpression="() => selectedPaymentId">
								@for (int i = 0; i < orderService.DownloadedPaymentMethods.Count; i++)
								{
									if (orderService.DownloadedPaymentMethods[i].Id == 1 || orderService.DownloadedPaymentMethods[i].Id == 2 ||
						orderService.DownloadedPaymentMethods[i].Id == 5)
									{
										var paymentMethod = orderService.DownloadedPaymentMethods[i];
										<label>
											<InputRadio Value="@paymentMethod.Id" />
											@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? paymentMethod.Description_ar : paymentMethod.Description_de)
										</label>
									}
								}
							</InputRadioGroup>

						</div>
						@* Discount Code *@
						<div class="discountClass">
							<label>Hast du Rabatt Code?</label>
							<div class="input-group d-flex gap-2 mb-1">
								<InputText class="form-control" @bind-Value="discountCode.Code" />
								<button type="button" class="btn btn-primary" @onclick="OnCode">
									@if (IsDiscountCodeLoading)
									{
										<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
									}
									else
									{
										<span>Code eingeben</span>
									}
								</button>
							</div>
							@{
								string message = null!;
								if (discountCode.Message != null && !string.IsNullOrEmpty(discountCode.Message))
								{
									message = discountCode.Message;
								}
								else if (discountCategory.Message != null && !string.IsNullOrEmpty(discountCategory.Message))
								{
									message = discountCategory.Message;
								}

								double DiscountPercentageText =
								discountCode.DiscountPercentage != 0
								? discountCode.DiscountPercentage
								: discountCategory.DiscountPercentage != 0
								? discountCategory.DiscountPercentage
								: 0;

								<label class="mt-2 text-success">Rabattprozentsatz: @DiscountPercentageText %</label>
								<label class="mt-2 text-danger">@message</label>
							}
						</div>
						@* shipping *@
						@if (selectedPaymentId == 5)
						{
							<div class="shipping">
								<h4>Versandmethode:</h4>
								<div class="shippingProvider">
									<InputRadioGroup @bind-Value="@order.ShippingProviderId">
										@foreach (ShippingProvider item in orderService.DownloadedShippingProviders)
										{
											if(item.Id == 1)
											{
												<label>
													<InputRadio Value="@item.Id" />
													@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? item.Name_ar : item.Name_de)
												</label>
											}
										}
									</InputRadioGroup>
								</div>
								<label>Versandkosten:<span style="font-weight:bold;">&nbsp;@((order.ShippingProviders?.PublicShippingCost ?? 0).ToString("C", new System.Globalization.CultureInfo("de-DE")))</span></label>
							</div>
						}
						<div class="placeOrder">
							Artikel: @cartService.GetTotalQuantity()
							<span>
								@if (discountCode != null && discountCode.Id > 0)
								{
									var result = GetFinalPriceWithDiscount();
									<span class="text-success">Es wird bei deinem Einkauf gespart @result.discountValue.ToString("C", new System.Globalization.CultureInfo("de-DE")) </span>
								}
								else if (discountCategory != null && discountCategory.Id > 0 && discountCategory.CategoriesId > 0)
								{
									var result = GetFinalPriceWithDiscountCategory();
									<span class="text-success">Es wird bei deinem Einkauf gespart @result.discountValue.ToString("C", new System.Globalization.CultureInfo("de-DE")) </span>
								}
								else
								{
									GetFinalPrice();
								}
							</span>
							@{
								double totalPrice = 0;
								if (order.ShippingProviders != null && order.ShippingProviderId > 0)
								{
									<span>Versandkosten: @order.ShippingProviders.PublicShippingCost.ToString("C", new System.Globalization.CultureInfo("de-DE"))</span>
									totalPrice = order.TotalPrice + order.ShippingProviders.PublicShippingCost;
								}
								else
									totalPrice = order.TotalPrice;
							}
							<span><strong>Gesamtpreis:</strong> @totalPrice.ToString("C", new System.Globalization.CultureInfo("de-DE"))</span>
							<span>Die Preise beinhalten MwSt.</span>
						</div>
						<div class="OrderClassB">
							<button type="button" class="btn InvoiceGenerateB" @onclick="OnInvoiceGenerate"
							disabled="@((selectedAddress && selectedPaymentId > 0) ? false : true)">Rechnung erstellen</button>
							<button type="button" class="btn InvoiceGeneratCancelB" @onclick="OnOrderCancel">Abbrechnen</button>
						</div>
					</div>
				</div>
			}
			@* Rechnung *@
			<ManagementLabel.Components.Layout.InvoiceLayout invoice="invoice" IsInvoiceVisible="IsInvoiceVisible" OnClose="HandleInvoiceClose" />
		</Authorized>
		<NotAuthorized>
			<ManagementLabel.Components.Pages.LogIn />
		</NotAuthorized>
	</AuthorizeView>
</div>
@code{

	private string GetScr(Products product)
	{
		string scr = productImagesService.GetProductImageUrl(product.ProductImages?.FirstOrDefault(img => img.IsMain)!);

		if(product.Id == 304)
		{

		}

		return scr;
	}

	// show Colmuns
	private List<ColumnOption> columnOptions = new()
    {
	  new("Index", "Index", true),
	  new("Id", "Id", false),
	  new("Name de", "Name_de", true),
	  new("Beschreibung de", "Description_de", true),
	  new("Name ar", "Name_ar", false),
	  new("Beschreibung ar", "Description_ar", false),
	  new("Kategorie", "Category", true),
	  new("Barcode", "Barcode", false),
	  new("Menge", "Quantity", true),
	  new("Kaufpreis", "PurchasePrice", true),
	  new("Verkaufspreis", "SellePrice", true),
	  new("Mindestbestand", "MinimumStock", true),
	  new("Ablaufdatum", "ExpDate", true),
	  new("Hersteller", "Manufacturer", true),
	  new("Steuersatz", "TaxRate", false),
	  new("Gruppe", "Group", false),
	  new("Versandfähig", "IsShippable", false),
	  new("Im Angebot", "DiscountedPrice", false),
	  new("Benutzername", "Username", false),
	  new("Img", "Img", true),
    };
	private bool ShowColumn(string key) => columnOptions.FirstOrDefault(c => c.Key == key)?.IsVisible == true;
	protected override async Task OnInitializedAsync()
	{
		_ = categoryService.GetAllCategoriesAsync();

		//await LocalStorage.RemoveItemAsync("columnOptions");

		var saved = await LocalStorage.GetItemAsync<List<ColumnOption>>("columnOptions");
		if (saved is not null)
			columnOptions = saved;
	}
	private async Task OnColumnChanged()
	{
		// كل ما يتغير أي Checkbox، نحفظ القائمة
		await LocalStorage.SetItemAsync("columnOptions", columnOptions);
	}
	// OnAfterRenderAsync
	private Users? user;
	private DotNetObjectReference<ProductsManagement>? objRef;
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			var authState = await AuthProvider.GetAuthenticationStateAsync();
			var user = authState.User;
			if (user.Identity?.IsAuthenticated == true)
			{
				this.user = new();
				var userIdStr = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value!;
				if (int.TryParse(userIdStr, out int userIdInt))
				{
					this.user.Id = userIdInt;
				}
				//// Reset when the page reloads
				ResetOfPage();
				//
				await loadInBackground();
				// Das Donnet-Objekt für die Verwendung in JavaScript abrufen
				objRef = DotNetObjectReference.Create(this);
				await Task.Delay(100);
				// Setzen Sie das Objekt von donNet in JavaScript und die ID:checkScrollEnd und rufen Sie die Funktion checkScrollEnd aus JavaScript ab.
				_ = JS.InvokeVoidAsync("checkScrollEnd", objRef, "scrollContainer");
			}
		}
	}

	// Menu recht klicken
	private bool showContextMenu = false;
	private double menuX;
	private double menuY;
	private string menuXpx => $"{menuX}px";
	private string menuYpx => $"{menuY}px";
	private Products? selectedProduct;
	private System.Timers.Timer? longPressTimer;
	private double startX, startY;
	private bool isDragging = false;

	private void HideContextMenu() => showContextMenu = false;
	// Select
	private Products? selectedRow;
	private void OnSelectRow(Products product, MouseEventArgs e)
	{
		// wenn in Bearbeitungsmodus, Addsmodus,Deletsmodus, Invoicesmodus oder Ordersmodus, kein Kontextmenü anzeigen
		if (_editProduct != null || IsShowAddProductForm || IsDeleting || IsShowInvoice || IsShowOrder)
			return;

		if (e.Button == 2) // right click
		{
			selectedProduct = product;
			menuX = e.ClientX;
			menuY = e.ClientY;
			showContextMenu = true;
		}
		selectedRow = product;
	}
	private void OnTouchStart(Products product, PointerEventArgs e)
	{
		// wenn in Bearbeitungsmodus, Addsmodus,Deletsmodus, Invoicesmodus oder Ordersmodus, kein Kontextmenü anzeigen
		if (_editProduct != null || IsShowAddProductForm || IsDeleting || IsShowInvoice || IsShowOrder)
			return;

		startX = e.ClientX;
		startY = e.ClientY;
		isDragging = false;

		//Timer für langes Drücken (eine halbe Sekunde)
		longPressTimer = new System.Timers.Timer(600);
		longPressTimer.Elapsed += (_, __) =>
		{
			if (!isDragging) // nur wenn nicht gezogen wird
			{
				InvokeAsync(() =>
				{
					selectedProduct = product;
					menuX = e.ClientX;
					menuY = e.ClientY;
					showContextMenu = true;
					StateHasChanged();
				});
			}
			longPressTimer?.Stop();
		};
		longPressTimer.AutoReset = false;
		longPressTimer.Start();
		// select die Row
		selectedRow = product;
	}
	private void OnTouchMove(PointerEventArgs e)
	{
		// إذا تحرك الإصبع أكثر من 10px → اعتبره سحب
		if (Math.Abs(e.ClientX - startX) > 10 || Math.Abs(e.ClientY - startY) > 10)
		{
			isDragging = true;
			longPressTimer?.Stop();
		}
	}
	private void OnTouchEnd(PointerEventArgs e)
	{
		// Wenn der Benutzer seinen Finger schnell anhebt → das Menü öffnet sich nicht
		longPressTimer?.Stop();
	}

	// load products
	private bool IsLoadding = false;
	private async Task<bool> loadInBackground()
	{
		if (IsLoadding) return false;
		IsLoadding = true;
		var moreProducts = await productService.LoadMoreProducts();


		// initialize CartItem for each product
		foreach (var product in moreProducts.Items)
		{
			product.InitializeCartItem(cartService.GetQuantityOfProduct(product.Id));
		}
		// hide the loading message
		IsLoadingMessage = false;
		StateHasChanged();
		IsLoadding = false;
		return moreProducts.AllItemsLoaded;
	}
