	private (double discountValue, double finalPrice) GetFinalPriceWithDiscount()
	{
		if (discountCode == null || discountCode.Id == 0)
		{
			return (0, cartService.GetTotalPrice());
		}
		double discountValue = (cartService.GetTotalPrice() * discountCode?.DiscountPercentage / 100.0 ?? 0);
		double finalPrice = cartService.GetTotalPrice() - discountValue;

		order.DiscountCodeId = discountCode!.Id;
		order.DiscountCode = discountCode;
		order.TotalPrice = finalPrice;

		return (discountValue, finalPrice);
	}
	private (double discountValue, double finalPrice) GetFinalPriceWithDiscountCategory()
	{
		if (discountCategory == null || discountCategory.Id == 0)
		{
			return (0, cartService.GetTotalPrice());
		}
		// get total price of category items
		double categoryitemsPrice = 0;
		foreach (var item in cartService.CartItems)
		{
			if (item.Product.CategoryId == discountCategory.CategoriesId)
			{
				categoryitemsPrice += item.Product.SalePrice * item.Quantity;
			}
		}
		// get price with discount of category
		double categoryDiscountValue = categoryitemsPrice * (discountCategory.DiscountPercentage / 100.0);
		// final price with discount of category
		double finalPrice = cartService.GetTotalPrice() - categoryDiscountValue;

		order.DiscountCategoryId = discountCategory.Id;
		order.DiscountCategory = discountCategory;
		order.TotalPrice = finalPrice;

		return (categoryDiscountValue, finalPrice);
	}
	private void GetFinalPrice()
	{
		order.TotalPrice = cartService.GetTotalPrice();
	}
	private async Task OnPaymentChanged(int newPaymentId)
	{
		// 5 ist die payment überweisung dass bedeuetet die versandkosten soll verlangt werden
		if (newPaymentId == 5)
		{
			// get ShippingProvider if not loaded
			if (orderService.DownloadedShippingProviders == null || orderService.DownloadedShippingProviders.Count == 0)
				await orderService.GetShippingProvidersAsync();

			// set default value
			if (order.ShippingProviderId == null)
			{
				// 1 ist die Standard-ID des Versandanbieters
				order.ShippingProviderId = 1;
				order.ShippingProviders = orderService.DownloadedShippingProviders?.FirstOrDefault(o => order.ShippingProviderId == order.ShippingProviderId) ?? null;
				// add die versandkosten to cart
			}
		}
		else
		{
			// Versandanbieter zurücksetzen, wenn keine Versandzahlungsmethode verwendet wird
			order.ShippingProviderId = null;
		}

		selectedPaymentId = newPaymentId;
		StateHasChanged();
	}
