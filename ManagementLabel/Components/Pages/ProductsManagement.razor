	// Overlay Form Handel
	private void HandleEditProduct((Products product, string Action, bool ActionState) data)
	{
		if (data.Action == "Edit")
		{
			// edit if in Filter mode
			if (data.product != null)
			{
				if (filterP != null && filterP.Count > 0)
				{
					int filterIndex = filterP.FindIndex(p => p.Id == data.product.Id);
					if (filterIndex >= 0)
					{
						filterP[filterIndex] = data.product; // Update the product in the filtered list
					}
				}
				data.product = null!;
			}

			if (!data.ActionState)
			{
				// Hide the edit form
				_editProduct = null!;
			}
		}
		else if (data.Action == "Add")
		{
			// add if in Filter mode
			if (data.product != null)
			{
				if (filterP != null && filterP.Count > 0)
				{
					// Add the new product to the filtered list
					filterP.Insert(0,data.product); 
				}
			}

			if (!data.ActionState)
			{
				// Hide the add form
				IsShowAddProductForm = false;
				newProduct = new();
			}
		}
	}
	// Search
	private List<Products> filterP = null!;
	private string searchText = string.Empty;
	public async void OnTextChanged(ChangeEventArgs e)
	{
		searchText = e.Value?.ToString()?.Trim() ?? string.Empty;
		if ((productService.DownloadedProduct.Count == 0 || string.IsNullOrEmpty(searchText)) && selectedCategoryId == 0)
		{
			filterP = null!;
			return;
		}
		else if(selectedCategoryId != 0)
		{
			// if a category is selected, filter the products by category and search text
			filterP = productService.DownloadedProduct
				.Where(p => p.CategoryId == selectedCategoryId &&
					(p.Id.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Name_de!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Category!.Name_de!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Quantity.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Manufacturer!.Name!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.PurchasePrice.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.SalePrice.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.MinimumStock.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)))
				.ToList();
		}
		else if (productService.DownloadedProduct.Count > 0)
		{
			int counter = 0;
			while (true)
			{
				if (counter > 10) 
				{
					break;
				}

				filterP = SearchInProductsLocal(searchText);
				if (filterP.Count > 0)
					break;
				Task.Delay(100).Wait(); // wait for a short time before searching again
										// if no products found, load more products
				bool AllItemsLoaded = await loadInBackground();
				if (AllItemsLoaded) break;
				counter++;
			}
		}
	}
	private async Task ClearInput()
	{
		try
		{
			if (selectedCategoryId == 0)
			{
				await JS.InvokeVoidAsync("clearSearchBox", "searchBox");

				filterP = null!;
			}
			else
			{
				await JS.InvokeVoidAsync("clearSearchBox", "searchBox");
			}
		}
		catch
		{

		}
	}
	private List<Products> SearchInProductsLocal(string searchText)
	{
		var searchedProducts = productService.DownloadedProduct
					.Where(p =>
					p.Id.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Name_de!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Category!.Name_de!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Quantity.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Manufacturer!.Name!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.PurchasePrice.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.SalePrice.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.MinimumStock.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase))
					.ToList();
		return searchedProducts;
	}
