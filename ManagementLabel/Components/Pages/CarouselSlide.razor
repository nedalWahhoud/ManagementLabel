@page "/carousel"

<div class="p-2 min-vh-100 w-100">
<AuthorizeView>
	<Authorized Context="authContext">
		@if (authContext.User.HasClaim("permission", "manageCarousel") || authContext.User.HasClaim("permission", "fullAccess"))
		{
			<div class="tableResponsive">
			  <div class="topTable">
						<button class="btn addPlusB" @onclick="NewCarouselImage" title="Add neues Karussellbild">+</button>
			  </div>
			  @if (carouselImageService.DownloadedCarouselImage == null || carouselImageService.DownloadedCarouselImage.Count == 0)
		  	  {
				<div class="d-flex justify-content-center align-items-center"
				style="min-height: 60vh;">
					<p class="text-muted fs-5">
						Keine Carousel Images gefunden.
					</p>
				</div>
			  }
			  else
			  {
				<div class="row">
					@foreach (var carouselImage in carouselImageService.DownloadedCarouselImage)
					{
						<div class="col-md-4 mb-4">
							<div class="card h-100 shadow-sm">
								@if (!string.IsNullOrEmpty(carouselImage.ImageUrl))
								{
									<img src="@carouselImageService.GetImageUrl(carouselImage)" class="card-img-top" style="object-fit: cover; height: 200px;" />
								}

								<div class="card-body d-flex flex-column">
									<h5 class="card-title">ID: @carouselImage.Id</h5>
									<p class="card-text mb-1"><strong>Start:</strong> @carouselImage.StartDate.ToShortDateString()</p>
									<p class="card-text mb-1"><strong>End:</strong> @carouselImage.EndDate.ToShortDateString()</p>
									<p class="card-text mb-2"><strong>Order:</strong> @carouselImage.DisplayOrder</p>

									<div class="mt-auto d-flex justify-content-between">
										<button class="btn btn-sm btn-warning" @onclick="() => EditCarouselImage(carouselImage)" disabled="@IsProcessing.Item1">
											<i class="bi bi-pencil"></i> Bearbeiten
										</button>
										<button class="btn btn-sm btn-danger" @onclick="() => DeleteCarouselImage(carouselImage.Id)" disabled="@IsProcessing.Item1">
											@if (IsProcessing.Item1 && IsProcessing.Item2 == carouselImage.Id)
											{
												<span class="spinner-border spinner-border-sm"
												role="status"
												aria-hidden="true"></span>
											}
											else
											{
												<span><i class="bi bi-trash"></i> Löschen</span>
											}
										</button>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			  }
			</div>
			@if (IsAdding)
			{
				<ManagementLabel.Components.Layout.OverlayEditAddCarouselImage carouselImage="new CarouselImage()" Action="Add" OnHandel="HandleEditAddCarouselImage" />
			}
			else if (IsEditing)
			{
				<ManagementLabel.Components.Layout.OverlayEditAddCarouselImage carouselImage="EditingCarouselImage" Action="Edit" OnHandel="HandleEditAddCarouselImage" />
			}
		}
		else
		{
			<div style="display:flex; justify-content:center; align-items:center; height:80vh;">
				<div class="alert alert-danger text-center">
					Sie haben keine Berechtigung für diese Seite
				</div>
			</div>
		}
	</Authorized>
	<NotAuthorized>
		<ManagementLabel.Components.Pages.LogIn />
	</NotAuthorized>
</AuthorizeView>
</div>

@code {

	private CarouselImage EditingCarouselImage = new CarouselImage();
	private bool IsAdding = false;
	private bool IsEditing = false;
	private (bool,int) IsProcessing = (false,0);
	protected override async Task OnInitializedAsync()
	{
		var authState = await authProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		var canViewCoupons = user.HasClaim("permission", "manageCarousel") ||
								user.HasClaim("permission", "fullAccess");
		if (canViewCoupons)
		{
			await carouselImageService.GetAllCarouselAsync();
		}
	}

	private void NewCarouselImage()
	{
		IsAdding = true;
	}
	private void EditCarouselImage(CarouselImage carouselImage)
	{
		EditingCarouselImage = new CarouselImage
			{
				Id = carouselImage.Id,
				ImageUrl = carouselImage.ImageUrl,
				ImageUrlLocal = carouselImage.ImageUrlLocal,
				StartDate = carouselImage.StartDate,
				EndDate = carouselImage.EndDate,
				DisplayOrder = carouselImage.DisplayOrder,
				LastModified = carouselImage.LastModified
			};
		IsEditing = true;
	}
	private async Task DeleteCarouselImage(int id)
    {
		IsProcessing = (true,id);
		var resultConfirm = await JS.InvokeAsync<bool>("confirm", $"Möchten Sie das Carousel-Image mit der ID {id} wirklich löschen?");
		if (resultConfirm)
		{
		    var result = await carouselImageService.DeleteCarouselImageAsync(id);
			await JS.InvokeVoidAsync("alert", result.Message);
		}
		IsProcessing = (false,id);
    }
	private void HandleEditAddCarouselImage(string action)
	{
		if (action == "Add")
		{
			IsAdding = false;
		}
		else
		{
			IsEditing = false;
		}
	}
}
