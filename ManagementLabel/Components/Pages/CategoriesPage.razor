@page "/categories"

<div class="mainDiv">
<AuthorizeView>
	<Authorized Context="authContext">
			@if (authContext.User.HasClaim("permission", "manageCategories") || authContext.User.HasClaim("permission", "fullAccess"))
			{
				<div class="tableContiner">
					<div class="topTable">
						<div class="buttonsDiv">
							<button class="btn addPlusB" @onclick="NewCategory" title="Add neue Kategorie">+</button>
						</div>
					</div>
				  <table class="table table-bordered table-hover">
					<tr>
						<th>Id</th>
						<th>Name de</th>
						<th>Name ar</th>
						<th>Ab 18 Jahren</th>
						<th>Ist Aktiv</th>
					</tr>
					<tbody>
						@foreach (var category in categoryService.DownloadedCategories)
						{
							<tr>
								<td>@category.Id</td>
								<td>@category.Name_de</td>
								<td>@category.Name_ar</td>
								<td><InputCheckbox @bind-Value="category.Requires18Plus" /></td>
								<td><InputCheckbox @bind-Value="category.IsAktiv" /></td>
								<td>
									<button class="btn btn-sm btn-warning me-1"
									@onclick="() => EditGroup(category)" disabled="@IsDeletingProcessing.Item1">
										Bearbeiten
									</button>
									<button class="btn btn-sm btn-danger"
									@onclick="() => DeleteGroup(category.Id)" disabled="@IsDeletingProcessing.Item1">
										@if (IsDeletingProcessing.Item1 && IsDeletingProcessing.Item2 == category.Id)
										{
											<span class="spinner-border spinner-border-sm"
											role="status"
											aria-hidden="true"></span>
										}
										else
										{
											<span>Löschen</span>
										}
									</button>
								</td>
							</tr>
						}
					</tbody>
				  </table>
				</div>
			}
			else
			{
				<div style="display:flex; justify-content:center; align-items:center; height:80vh;">
					<div class="alert alert-danger text-center">
						Sie haben keine Berechtigung für diese Seite
					</div>
				</div>
			}
		@if (IsAdding)
		{
			<ManagementLabel.Components.Layout.OverlayEditAddCategories category="new Categories()" Action="Add" OnHandel="HandleEditCategory" />
		}
		@if (IsEditing)
		{
			<ManagementLabel.Components.Layout.OverlayEditAddCategories category="EditingCategory" Action="Edit" OnHandel="HandleEditCategory" />
		}
	</Authorized>
	<NotAuthorized>
		<ManagementLabel.Components.Pages.LogIn />
	</NotAuthorized>
</AuthorizeView>
</div>


@code {
	private Categories EditingCategory = null!;
	private bool IsAdding = false;
	private bool IsEditing = false;
	protected async override Task OnInitializedAsync()
	{
		var authState = await authProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		var canViewCoupons = user.HasClaim("permission", "manageCategories") ||
								user.HasClaim("permission", "fullAccess");
		if (canViewCoupons)
		{
			// get all categories
			await categoryService.GetAllCategoriesAsync();
		}
	}
	private void NewCategory()
	{
		IsAdding = true;
	}
	private void EditGroup(Categories category)
	{
		EditingCategory = new Categories
			{
				Id = category.Id,
				Name_de = category.Name_de,
				Name_ar = category.Name_ar,
				Requires18Plus = category.Requires18Plus,
				IsAktiv = category.IsAktiv
			};
		IsEditing = true;

	}
	private (bool,int) IsDeletingProcessing = (false,0);
	private async Task DeleteGroup(int id)
	{
		if (id <= 0)
		{
			await JS.InvokeVoidAsync("alert", "Please select a Category");
			return;
		}
		IsDeletingProcessing = (true,id);
		var resultConfirm = await JS.InvokeAsync<bool>("confirm", $"Möchten Sie das Category mit der ID {id} wirklich löschen?");
		if (resultConfirm)
		{
			var result = await categoryService.DeleteCategoryAsync(id);
			if (!result.Result)
			{
				await JS.InvokeVoidAsync("alert", result.Message);
			}
		}
		IsDeletingProcessing = (false,id);
	}
	private void HandleEditCategory(string action)
	{
		if (action == "Add")
		{
			IsAdding = false;
		}
		else
		{
			IsEditing = false;
			EditingCategory = null!;
		}
	}
}
