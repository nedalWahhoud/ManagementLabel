@page "/groupproduct"
<div class="p-2 min-vh-100 w-100">
<AuthorizeView>
	<Authorized Context="authContext">
			@if (authContext.User.HasClaim("permission", "manageProduct_groups") || authContext.User.HasClaim("permission", "fullAccess"))
			{
				<div class="tableResponsive">
				 <div class="topTable">
					<button class="btn addPlusB" @onclick="NewGroup" title="Add neue Vertriebslinie">+</button>
				 </div>
				 <table class="table table-bordered table-hover">
					<tr>
						<th>Id</th>
						<th>Name de</th>
						<th>Name ar</th>
					</tr>
					<tbody>
						@foreach (var group in productGroupService.DownloadedproductGroups)
						{
							<tr>
								<td>@group.Id</td>
								<td>@group.GroupName_de</td>
								<td>@group.GroupName_ar</td>
								<td>
									<button class="btn btn-sm btn-warning me-1"
									@onclick="() => EditGroup(group)" disabled="@IsDeletingProcessing.Item1">
										Bearbeiten
									</button>
									<button class="btn btn-sm btn-danger"
									@onclick="() => DeleteGroup(group.Id)" disabled="@IsDeletingProcessing.Item1">
										@if (IsDeletingProcessing.Item1 && IsDeletingProcessing.Item2 == group.Id)
										{
											<span class="spinner-border spinner-border-sm"
											role="status"
											aria-hidden="true"></span>
										}
										else
										{
											<span>Löschen</span>
										}
									</button>
								</td>
							</tr>
						}
					</tbody>
				 </table>
				</div>
			}
			else
			{
				<div style="display:flex; justify-content:center; align-items:center; height:80vh;">
					<div class="alert alert-danger text-center">
						Sie haben keine Berechtigung für diese Seite
					</div>
				</div>
			}

		@if (IsAdding)
		{
			<ManagementLabel.Components.Layout.OverlayEditAddGroupProducts groupProduct="new GroupProducts()" Action="Add" OnHandel="HandleEditAddGroupProduct" />
		}
		@if (IsEditing)
		{
			<ManagementLabel.Components.Layout.OverlayEditAddGroupProducts groupProduct="EditingGroupProduct" Action="Edit" OnHandel="HandleEditAddGroupProduct" />
		}
	</Authorized>
	<NotAuthorized>
		<ManagementLabel.Components.Pages.LogIn />
	</NotAuthorized>
</AuthorizeView>
</div>

@code {
	private GroupProducts EditingGroupProduct = null!;
	private bool IsEditing = false;
	private bool IsAdding = false;
	protected async override Task OnInitializedAsync()
	{
		var authState = await authProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		var canViewCoupons = user.HasClaim("permission", "manageProduct_groups") ||
								user.HasClaim("permission", "fullAccess");
		if (canViewCoupons)
		{
			await productGroupService.GetAllGroupProductsAsync();
		}
	}

	private void NewGroup()
	{
		IsAdding = true;
	}
	private void EditGroup(GroupProducts group)
	{
		EditingGroupProduct = new GroupProducts
			{
				Id = group.Id,
				GroupName_de = group.GroupName_de,
				GroupName_ar = group.GroupName_ar
			};
		IsEditing = true;
	}
	private (bool,int) IsDeletingProcessing = (false,0);
	private async Task DeleteGroup(int  id)
	{
		if (id <= 0 )
		{
			await JS.InvokeVoidAsync("alert", "Please select a Group");
			return;
		}
		IsDeletingProcessing = (true,id);
		var resultConfirm = await JS.InvokeAsync<bool>("confirm", $"Möchten Sie das Gruppe mit der ID {id} wirklich löschen?");
		if (resultConfirm)
		{
			var result = await productGroupService.DeleteGroupProducts(id);
			if (!result.Result)
			{
				await JS.InvokeVoidAsync("alert", result.Message);
			}
			
		}
		IsDeletingProcessing = (false,id);
	}

	private void HandleEditAddGroupProduct(string action)
	{
		if (action == "Add")
		{
			IsAdding = false;
		}
		else
		{
			IsEditing = false;
			EditingGroupProduct = null!;
		}
	}
}
