	private async Task EditProductImageUpload(InputFileChangeEventArgs e)
	{
		_editProduct = await UploadImage(e, _editProduct!);
	}
	private async Task EditProduct()
	{
		// if null
		if (_editProduct == null)
		{
			await ShowAlert("Nothing has changed");
			return;
		}
		// if no edited
		Products? currentProduct = productService.DownloadedProduct.Find(p => p.Id == _editProduct.Id);
		bool isEdited = productService.IsEditedProduct(currentProduct!, _editProduct);
		if (!isEdited)
		{
			await ShowAlert("Nothing has changed");
			return;
		}

		var result = await productService.UpdateProductAsync(_editProduct);
		if (result.Result)
		{
			// set Catgory in editproduct
			_editProduct!.Category = categories.FirstOrDefault(c => c.Id == _editProduct.CategoryId);
			// set Manufacturer in editproduct
			_editProduct!.Manufacturer = Manufacturers!.FirstOrDefault(m => m.Id == _editProduct.ManufacturerId);
			// set TaxRate in editproduct
			_editProduct!.TaxRate = TaxRates!.FirstOrDefault(m => m.Id == _editProduct.TaxRateId);
			// set Group in editproduct
			_editProduct!.ProductGroup = groupedProducts!.FirstOrDefault(m => m.Id == _editProduct.ProductGroupID);

			// Update the product in the list
			int index = productService.DownloadedProduct!.FindIndex(p => p.Id == _editProduct.Id);
			productService.DownloadedProduct[index] = _editProduct!; // Update the product in the list

			// if in search mode
			if (filterP != null && filterP.Count > 0)
			{
				int filterIndex = filterP.FindIndex(p => p.Id == _editProduct.Id);
				if (filterIndex >= 0)
				{
					filterP[filterIndex] = _editProduct; // Update the product in the filtered list
				}
			}
			selectedRow = null!;
			_editProduct = null!;
			_ = ShowAlert(result.Message!);
			StateHasChanged();
		}
		else
		{
			await ShowAlert(result.Message!);
		}
	}
	private void EditProductCancel()
	{
		// Reset the selected row
		selectedRow = null!;
		// Hide the edit form
		_editProduct = null!;
	}
	// Search
	private List<Products> filterP = null!;
	private string searchText = string.Empty;
	public async void OnTextChanged(ChangeEventArgs e)
	{
		searchText = e.Value?.ToString()?.Trim() ?? string.Empty;
		if ((productService.DownloadedProduct.Count == 0 || string.IsNullOrEmpty(searchText)) && selectedCategoryId == 0)
		{
			filterP = null!;
			return;
		}
		else if(selectedCategoryId != 0)
		{
			// if a category is selected, filter the products by category and search text
			filterP = productService.DownloadedProduct
				.Where(p => p.CategoryId == selectedCategoryId &&
					(p.Id.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Name_de!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Category!.Name_de!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Quantity.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Manufacturer!.Name!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.PurchasePrice.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.SalePrice.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.MinimumStock.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)))
				.ToList();
		}
		else if (productService.DownloadedProduct.Count > 0)
		{
			int counter = 0;
			while (true)
			{
				if (counter > 10) 
				{
					break;
				}

				filterP = SearchInProductsLocal(searchText);
				if (filterP.Count > 0)
					break;
				Task.Delay(100).Wait(); // wait for a short time before searching again
										// if no products found, load more products
				bool AllItemsLoaded = await loadInBackground();
				if (AllItemsLoaded) break;
				counter++;
			}
		}
	}
	private async Task ClearInput()
	{
		try
		{
			if (selectedCategoryId == 0)
			{
				await JS.InvokeVoidAsync("clearSearchBox", "searchBox");

				filterP = null!;
			}
			else
			{
				await JS.InvokeVoidAsync("clearSearchBox", "searchBox");
			}
		}
		catch
		{

		}
	}
	private List<Products> SearchInProductsLocal(string searchText)
	{
		var searchedProducts = productService.DownloadedProduct
					.Where(p =>
					p.Id.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Name_de!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Category!.Name_de!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Quantity.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.Manufacturer!.Name!.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.PurchasePrice.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.SalePrice.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
					p.MinimumStock.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase))
					.ToList();
		return searchedProducts;
	}
	private async Task OnCategoryOpened()
	{
		await loadCategories();
	}
	private int selectedCategoryId = 0;
	private async Task OnCategoryChanged(ChangeEventArgs e)
	{
		// show loadingmessage while loading
		IsLoadingMessage = true;
		if (int.TryParse(e.Value?.ToString(), out int selectedId))
		{
			if (selectedId > 0)
			{
				selectedCategoryId = selectedId;
				// clear die Input search
				await ClearInput();
				if (productService.DownloadedProduct.Count > 0)
				{
					// get excludeProductsIds, from local products
					List<int> excludeProductsIds = productService.DownloadedProduct.Where(f => f.CategoryId == selectedId)
					.Select(f => f.Id)
					.ToList();

					int counter = 0;
					GetItems<Products> getItems = new();
					// do th filterP not null, to make the complete downloaded products disappear, and only isloadingMessage to show
					filterP = new();
					while (true)
					{
						if (counter > 10 || getItems.AllItemsLoaded)
						{
							break;
						}

						Task.Delay(100).Wait(); // wait for a short time before searching again
						getItems = await categoryService.GetProductsByCategoryIdAsync(selectedId, 10, excludeProductsIds);
						// get downloaded productsIds, to exclude them from the next search
						excludeProductsIds.AddRange(getItems.Items
							.Where(p => p.CategoryId == selectedId)
							.Select(p => p.Id));
						// initialize CartItem for each product
						foreach (var product in getItems.Items)
						{
							product.InitializeCartItem(cartService.GetQuantityOfProduct(product.Id));
						}
						counter++;
					}
					// get the products by categoryId local, after downloading from server
					filterP = productService.GetProductByCategoryIdLocal(selectedId);
				}
			}
			else
			{
				selectedCategoryId = 0;
				// if selectedId is 0, clear the filter
				filterP = null!;
			}
		}
		else
			selectedCategoryId = 0;
		IsLoadingMessage = false;
	}
