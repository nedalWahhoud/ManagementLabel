	private async Task<bool> loadInBackground()
	{
		if (isLoading) return false;
		isLoading = true;
		var moreProducts = await productService.LoadMoreProducts();
		if (moreProducts.Items.Any())
			products.AddRange(moreProducts.Items);

		// initialize CartItem for each product
		foreach (var product in moreProducts.Items)
		{
			product.InitializeCartItem(cartService.GetQuantityOfProduct(product.Id));
		}
		// hide the loading message
		IsLoadingMessage = false;
		StateHasChanged();
		isLoading = false;
		return moreProducts.AllItemsLoaded;
	}
