	private async Task AddProduct()
	{
		// add user, the new Product added 
		newProduct!.UserId = int.Parse(userId!);

		// Perform your logic to add the product to the database
		var result = await productService.AddProductAsync(newProduct!);
		var idStr = result.Message?.Split(':').LastOrDefault();
		// Check if the result is successful and Get the ID returned by the database
		if (result.Result && int.TryParse(idStr, out int id))
		{
			// set the ID of the new product
			newProduct!.Id = id;
			// set Category in newProduct
			newProduct!.Category = categories!.FirstOrDefault(c => c.Id == newProduct.CategoryId);
			// set Manufacturer in newProduct
			newProduct!.Manufacturer = Manufacturers!.FirstOrDefault(m => m.Id == newProduct.ManufacturerId);
			// set rate in newProduct
			newProduct!.TaxRate = TaxRates!.FirstOrDefault(t => t.Id == newProduct.TaxRateId);
			// set ProductGroup in newProduct
			newProduct!.ProductGroup = groupedProducts!.FirstOrDefault(g => g.Id == newProduct.ProductGroupID);
			// initaialize the caritem for this new product
			newProduct.InitializeCartItem(0);

			// Add the new product to the products list
			products.Insert(0, newProduct!); // Add the new product to the products list
			HideAddProductForm(); // Hide the form
			newProduct = new Products(); // Reset the new product model
		}
		else
		{
			_ = ShowAlert(result.Message!);
		}
	}
