	// image upload
	private async Task<Products> UploadImage(InputFileChangeEventArgs e, Products products)
	{
		if (e.File == null) return products;
		using var stream = new MemoryStream();

		Microsoft.AspNetCore.Components.Forms.IBrowserFile imageFile = e.File;
		try
		{
			// Check if the file size exceeds the limit
			if (imageFile.Size > 512000)
			{
				var array = await dpP.CompressImage(imageFile);
				products!.Image = array;
			}
			else
			{
				await imageFile.OpenReadStream().CopyToAsync(stream);
				products!.Image = stream.ToArray();
			}
		}
		catch (Exception ex)
		{
			_ = ShowAlert($"Error uploading image: {ex.Message}");
		}

		stream.Dispose();
		return products;
	}
