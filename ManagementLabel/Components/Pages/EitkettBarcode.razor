@page "/"
@using ManagementLabel.ProductsF;
@using ManagementLabel.EitkettBarcode
@using ManagementLabel.Model

@rendermode InteractiveServer

<AuthorizeView>
	<Authorized Context="authContext">
		<!-- user info -->
		<p class="userInfo">
			<span class="userName">User Name: @authContext.User.Identity!.Name</span>
		</p>
		@* top continer *@
		<div class="TopContiner">
			<button class="@(!IsShowAddProductForm ? "btn addProductTopB" : "btn addProductCancelB")" @onclick="ShowAddProductFormAsync" disabled="@(IsLoadingMessage)">
				@(!IsShowAddProductForm ? "Produkt hinzufügen" : "Hinzufügen Abbrechen")
			</button>
			<button class="@(!IsShowAddDeleteForm ? "btn deleteB" : "btn deleteCancelB")" @onclick="ShowAddDeleteForm" disabled="@(IsLoadingMessage || productService.DownloadedProduct.Count == 0)">
				@(!IsShowAddDeleteForm ? "Produkt löschen" : "Löschen Abbrechen")
			</button>
			@*<button class="@(!IsShowReceiptForm ? "btn receiptB" : "btn receiptCancelB")" @onclick="ShowReceiptForm" disabled="@(IsLoadingMessage || productService.DownloadedProduct.Count == 0)">
				@(!IsShowReceiptForm ? "Kassenbon erstellen" : "Kassenbon Abbrechen")
			</button*@
			<button class="@(!IsShowInvoice ? "btn InvoiceB" : "btn InvoiceCancelB")" @onclick="@(IsShowInvoice ? CancelOrderForm : ShowOrderForm)" disabled="@(IsLoadingMessage)">
				@(!IsShowInvoice ? "Rechnung erstellen" : "Rechnung Abbrechen")
			</button>
			<div class="searchWrapper">
				<input id="searchBox" type="text" placeholder="Searching..." class="searchInput" @oninput="OnTextChanged" disabled="@(IsLoadingMessage || productService.DownloadedProduct.Count == 0)" />
				<button class="clearButton" @onclick="ClearInput" disabled="@(IsLoadingMessage || productService.DownloadedProduct.Count == 0)">
					X
				</button>
			</div>
			@* category filter *@
			<select class="categoryDropdown" @onfocus="OnCategoryOpened" @onchange="OnCategoryChanged" disabled="@(IsLoadingMessage || productService.DownloadedProduct.Count == 0)">
				<option value="0">Alle</option>
				@foreach (var category in categories)
				{
					<option value="@category.Id">@category.Name_de</option>
				}
			</select>
		</div>
		@* choose the Columns *@
		<div class="mb-3">
			<strong>Wähle Spalten:</strong>
			@foreach (var col in columnOptions)
			{
				<label class="me-3">
					<input type="checkbox" @bind="col.IsVisible" />
					@col.Label
				</label>
			}
		</div>
		@* table *@
		<div tabindex="0" @onkeydown="KeyDown" id="scrollContainer" class="tableContiner">

			<table class="table">
				<thead>
					<tr>
						@if (ShowColumn("Index")) {<th>Index</th>}
						@if (ShowColumn("Id"))	{<th>Id</th>}
						@if (ShowColumn("Name_de")){<th>Name de</th>}
						@if (ShowColumn("Description_de")){<th>Beschreibung de</th>}
						@if (ShowColumn("Name_ar")){<th>Name ar</th>}
						@if (ShowColumn("Description_ar")){<th>Beschreibung ar</th>}
						@if (ShowColumn("Category")){<th>Kategorie</th>}
						@if (ShowColumn("Barcode")){<th>Barcode</th>}
						@if (ShowColumn("Quantity")){<th>Menge</th>}
						@if (ShowColumn("PurchasePrice")){<th>Kaufpreis</th>}
						@if (ShowColumn("SellePrice")){<th>Verkaufspreis</th>}
						@if (ShowColumn("MinimumStock")){<th>Mindestbestand</th>}
						@if (ShowColumn("ExpDate")){<th>Ablaufdatum</th>}
						@if (ShowColumn("Manufacturer")){<th>Hersteller</th>}
						@if (ShowColumn("TaxRate")){<th>Steuersatz</th>}
						@if (ShowColumn("Group")){<th>Gruppe</th>}
						@if (ShowColumn("IsShippable")){<th>Versandfähig</th>}
						@if (ShowColumn("Username")){<th>Benutzername</th>}
						@if (ShowColumn("Img")){<th>Img</th>}
						<th class="@(authContext.User.IsInRole("admin") && IsShowAddDeleteForm ? "" : "hidden")">Löschen</th>
						<th class="@(authContext.User.IsInRole("admin") && _editProduct!=null ? "" : "hidden")">Bearbeiten</th>
						<th class="@(authContext.User.IsInRole("admin") && IsShowReceiptForm ? "" : "hidden" )">Kassenbon</th> 
						<th class="@(authContext.User.IsInRole("admin") && IsShowInvoice ? "" : "hidden" )"><button class="btn InvoiceGeB" @onclick="OnOrderGenerate">Order erstellen</button></th>
					</tr>
				</thead>
				<tbody>
					@* Loading message *@
					<tr id="loadingMessage" class="@(!IsLoadingMessage ? "hidden" : "show")">
						<td colspan="11" class="loadingMessage">
							Lädt...
						</td>
					</tr>
					@* table *@
					@{
						List<Products> htmlProducts = null!;
						if (filterP == null)
							htmlProducts = productService.DownloadedProduct;
						else
							htmlProducts = filterP;
						if (htmlProducts.Count > 0)
						{
							for (int i = 0; i < htmlProducts.Count; i++)
							{
								string src = Convert.ToBase64String(htmlProducts[i].Image!);
								Products thisProducts = htmlProducts[i];
								<tr 
								@ondblclick="@(authContext.User.IsInRole("admin") ? (() => DoubleClick(thisProducts)) : null!)"
								@onclick="()=> SelectRow(thisProducts)" 
								class="@(selectedRow != null && selectedRow.Id == thisProducts.Id ? "selected" : "")">
									@if (ShowColumn("Index")){<td>@(startIndex + i + 1)</td>}
									@if (ShowColumn("Id")){<td>@htmlProducts[i].Id</td>}
									@if (_editProduct != null && _editProduct.Id == htmlProducts[i].Id)
									{
										@if (ShowColumn("Name_de")) {<td><InputText @bind-Value="_editProduct!.Name_de" /></td>}
										@if (ShowColumn("Description_de")) {<td><InputText @bind-Value="_editProduct!.Description_de" /></td>}
										@if (ShowColumn("Name_ar")) {<td><InputText @bind-Value="_editProduct!.Name_ar" /></td>}
										@if (ShowColumn("Description_ar")) {<td><InputText @bind-Value="_editProduct!.Description_ar" /></td>}
										@if (ShowColumn("Category"))
										{
											<td>
												<InputSelect class="form-control" @bind-Value="_editProduct.CategoryId">
													<option value="0">Select Category</option>
													@foreach (var category in categories)
													{
														<option value="@category.Id">@category.Name_de</option>
													}
												</InputSelect>
											</td>
										}
										@if (ShowColumn("Barcode")) {<td><InputText @bind-Value="_editProduct!.Barcode" /></td>}
										@if (ShowColumn("Quantity")) {<td><InputNumber @bind-Value="_editProduct!.Quantity" /></td>}
										@if (ShowColumn("PurchasePrice")) {<td><InputNumber @bind-Value="_editProduct!.PurchasePrice" /></td>}
										@if (ShowColumn("SellePrice")) {<td><InputNumber @bind-Value="_editProduct!.SalePrice" /></td>}
										@if (ShowColumn("MinimumStock")) {<td><InputNumber @bind-Value="_editProduct!.MinimumStock" /></td>}
										@if (ShowColumn("ExpDate")) {<td><InputDate @bind-Value="_editProduct.EXPDate" /></td>}
										@if (ShowColumn("Manufacturer"))
										{
											<td>
												<InputSelect class="form-control" @bind-Value="_editProduct.ManufacturerId">
													<option value="0">Select Category</option>
													@foreach (var Manufacturer in Manufacturers!)
													{
														<option value="@Manufacturer.Id">@Manufacturer.Name</option>
													}
												</InputSelect>
											</td>
										}
										@if (ShowColumn("TaxRate"))
										{
											<td>
												<InputSelect class="form-control" @bind-Value="_editProduct.TaxRateId">
													<option value="0">Select Rate</option>
													@foreach (var rate in TaxRates)
													{
														<option value="@rate.Id">@rate.Rate</option>
													}
												</InputSelect>
											</td>
										}
										@if (ShowColumn("Group"))
										{
											<td>
												<InputSelect class="form-control" @bind-Value="_editProduct.ProductGroupID">
													<option value="0">wählen Product Gruppe aus</option>
													@foreach (var groupProduct in groupedProducts!)
													{
														<option value="@groupProduct.Id">@groupProduct.GroupName_de</option>
													}
												</InputSelect>
											</td>
										}
										@if (ShowColumn("IsShippable")){<td><InputCheckbox @bind-Value="_editProduct.IsShippable" /></td>}
										@if (ShowColumn("Username")) {<td>@(_editProduct.User?.UserName ?? "")</td>}
										@if (ShowColumn("Img")) {<td><InputFile id="Image" class="form-control" OnChange="EditProductImageUpload" /></td>}
										<td class="@(authContext.User.IsInRole("admin")  && _editProduct!=null ? "editForm" : "hidden")">
											<button id="editProductB_@htmlProducts[i].Id.ToString()" class="editB" @onclick:stopPropagation="true" @onclick="() => EditProduct()">
												Edit
											</button>
											<button class="editCancelB" @onclick:stopPropagation="true" @onclick="() => EditProductCancel()">
												Cancel
											</button>
										</td>
									}
									else
									{
										@if (ShowColumn("Name_de")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Name_de</td>}
										@if (ShowColumn("Description_de")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Description_de</td>}
										@if (ShowColumn("Name_ar")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Name_ar</td> }
										@if (ShowColumn("Description_ar")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Description_ar</td>}
										@if (ShowColumn("Category")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Category!.Name_de</td>}
										@if (ShowColumn("Barcode")) { <td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Barcode</td> }
										@if (ShowColumn("Quantity")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;" class="@(htmlProducts[i].MinimumStock >= htmlProducts[i].Quantity ? "IsMinimumStock" : "")">@htmlProducts[i].Quantity</td>}
										@if (ShowColumn("PurchasePrice")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].PurchasePrice.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>}
										@if (ShowColumn("SellePrice")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].SalePrice.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>}
										@if (ShowColumn("MinimumStock")) {<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].MinimumStock</td>}
										@if (ShowColumn("ExpDate"))
										{
											@* check exp date *@
											var expDate = htmlProducts[i].EXPDate;
											string backgroundcolor = ""; // الافتراضي
											string color = "";

											if (expDate < DateTime.Today)
											{
												backgroundcolor = "red"; // منتهي
												color = "white";
											}
											else if (expDate <= DateTime.Today.AddMonths(1))
											{
												backgroundcolor = "orange"; // بقي أقل من شهر
												color = "white";
											}

											<td style="max-width: 200px; word-wrap: break-word; white-space: normal; background-color:@backgroundcolor; color:@color;">@(expDate!.ToString("dd.MM.yyyy")!)</td>
										}
										@if (ShowColumn("Manufacturer")){<td style="max-width: 100px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].Manufacturer!.Name</td>}
										@if (ShowColumn("TaxRate")) {<td style="max-width: 100px; word-wrap: break-word; white-space: normal;">@((htmlProducts[i].TaxRate?.Rate.ToString("0") + "%") ?? "")</td>}
										@if (ShowColumn("Group")) {<td style="max-width: 100px; word-wrap: break-word; white-space: normal;">@(htmlProducts[i].ProductGroup?.GroupName_de ?? "")</td>}
										@if (ShowColumn("IsShippable"))
										{
											<td style="max-width: 200px; word-wrap: break-word; white-space: normal;">@htmlProducts[i].IsShippable</td>
										}
										@if (ShowColumn("Username")){<td style="max-width: 100px; word-wrap: break-word; white-space: normal;">@(htmlProducts[i].User?.UserName ?? "")</td>}
										@if (ShowColumn("Img")){<td><img src="data:image/png;base64,@(!string.IsNullOrEmpty(src) ? src : "images/sample.jpg")" class="productImg" /> </td>}
									}

									<td class="@(authContext.User.IsInRole("admin") && IsShowAddDeleteForm ? "deleteForm" : "hidden")">
										<button @onclick:stopPropagation="true" @onclick="() => DeleteProduct(thisProducts.Id)">
											Delete
										</button>
									</td>
									@*<td class="@(authContext.User.IsInRole("admin") && IsShowReceiptForm ? "productsCart" : "hidden")">

										<button class="btn @(cartService.IsProductAdded(thisProducts.CartItem.ProductId)  ? "btnProductAdded" : "btnProduct") "
										@onclick="() => CartChanged(thisProducts)">
											@(cartService.IsProductAdded(thisProducts.CartItem.ProductId) ? $"➕({cartService.GetQuantityOfProduct(thisProducts.CartItem.ProductId)})" : "🛒")
										</button>
										<InputNumber @bind-Value="thisProducts.CartItem.Quantity" Min="0" class="form-control" />
									</td>*@
									@* Rechnung *@
									<td class="@(authContext.User.IsInRole("admin") && IsShowInvoice ? "AddDecresaseCard" : "hidden")">
										<ManagementLabel.Components.Layout.AddDecresaseCard ProductId="@thisProducts.CartItem.ProductId" OnQuantityChanged="HandleQuantityChanged" />
									</td>
								</tr>
							}
						}
						else if(!IsLoadingMessage&&startIndex==0)
						{
							<tr>
								<td colspan="11" class="loadingMessage">
									Keine Bestellungen gefunden.
								</td>
							</tr>
						}
						htmlProducts = null!;
					}
				</tbody>
			</table>
		</div>

		@* Add Product form *@
		@if (authContext.User.IsInRole("admin") == true && IsShowAddProductForm)
		{
			<div class="overlay">
				<div class="overlayAddForm">
					<div class="productForm">
						<h3>Neues Produkt hinzufügen</h3>
						<EditForm Model="@newProduct" OnValidSubmit="AddProduct">
							<DataAnnotationsValidator />
							<div class="formGroupAdd">
								<label for="Name">Product Name DE</label>
								<InputText id="Name" class="form-control" @bind-Value="newProduct!.Name_de" />
								<ValidationMessage For="@(() => newProduct.Name_de)" />
							</div>
							<div class="formGroupAdd">
								<label for="Description">Description DE</label>
								<InputText id="Description" class="form-control" @bind-Value="newProduct.Description_de" />
								<ValidationMessage For="@(() => newProduct.Description_de)" />
							</div>
							<div class="formGroupAdd">
								<label for="Name">اسم المنتج بل عربية</label>
								<InputText id="Name" class="form-control" @bind-Value="newProduct!.Name_ar" />
								<ValidationMessage For="@(() => newProduct.Name_ar)" />
							</div>
							<div class="formGroupAdd">
								<label for="Description">وصف المنتج بل عربية</label>
								<InputText id="Description" class="form-control" @bind-Value="newProduct.Description_ar" />
								<ValidationMessage For="@(() => newProduct.Description_ar)" />
							</div>
							<div class="formGroupAdd">
								<label for="category">Category</label>
								<InputSelect id="category" class="form-control" @bind-Value="newProduct.CategoryId">
									<option value="0">Select Category</option>
									@foreach (var category in categories)
									{
										<option value="@category.Id">@category.Name_de</option>
									}
								</InputSelect>
								<ValidationMessage For="@(() => newProduct.CategoryId)" />
							</div>
							<div class="formGroupAdd">
								<label for="Quantity">Quantity</label>
								<InputNumber id="Quantity" min="0" class="form-control" @bind-Value="newProduct.Quantity" />
								<ValidationMessage For="@(() => newProduct.Quantity)" />
							</div>
							<div class="formGroupAdd">
								<label for="PurchasePrice">Purchase Price</label>
								<InputNumber id="PurchasePrice" min="0" class="form-control" @bind-Value="newProduct.PurchasePrice" />
								<ValidationMessage For="@(() => newProduct.PurchasePrice)" />
							</div>
							<div class="formGroupAdd">
								<label for="SalePrice">Selling Price</label>
								<InputNumber id="SalePrice" min="0" class="form-control" @bind-Value="newProduct.SalePrice" />
								<ValidationMessage For="@(() => newProduct.SalePrice)" />
							</div>
							<div class="formGroupAdd">
								<label for="MinimumStock">Minimum Stock</label>
								<InputNumber id="MinimumStock" min="0" class="form-control" @bind-Value="newProduct.MinimumStock" />
								<ValidationMessage For="@(() => newProduct.MinimumStock)" />
							</div>
							<div class="formGroupAdd">
								<label for="EXPDate">Expiration Date</label>
								<InputDate id="EXPDate" class="form-control" @bind-Value="newProduct.EXPDate" />
								<ValidationMessage For="@(() => newProduct.EXPDate)" />
							</div>
							<div class="formGroupAdd">
								<label for="manufacturer">Manufacturer</label>
								<InputSelect id="category" class="form-control" @bind-Value="newProduct.ManufacturerId">
									<option value="0">Select Manufacturer</option>
									@foreach (var Manufacturer in Manufacturers!)
									{
										<option value="@Manufacturer.Id">@Manufacturer.Name</option>
									}
								</InputSelect>
								<ValidationMessage For="@(() => newProduct.ManufacturerId)" />
							</div>
							<div class="formGroupAdd">
								<label for="TaxRate">Steuersatz</label>
								<InputSelect  class="form-control" @bind-Value="newProduct.TaxRateId">
									<option value="0">Select Rate</option>
									@foreach (var rate in TaxRates)
									{
										<option value="@rate.Id">@rate.Rate</option>
									}
								</InputSelect>
								<ValidationMessage For="@(() => newProduct.TaxRateId)" />
							</div>
							<div class="formGroupAdd">
								<label for="ProductGroup">Product Gruppe</label>
								<InputSelect  class="form-control" @bind-Value="newProduct.ProductGroupID">
									<option value="0">wählen Product Gruppe aus</option>
									@foreach (var groupProduct in groupedProducts)
									{
										<option value="@groupProduct.Id">@groupProduct.GroupName_de</option>
									}
								</InputSelect>
								<ValidationMessage For="@(() => newProduct.ProductGroupID)" />
							</div>
							<div class="formGroupAdd">
								<label for="ProductGroup">Versandfähig</label>
								<InputCheckbox @bind-Value="newProduct.IsShippable" />
								<ValidationMessage For="@(() => newProduct.IsShippable)" />
							</div>
							<div class="formGroupAdd">
								<label for="Image">Image</label>
								<InputFile id="Image" class="form-control" OnChange="AddProductImageUpload" />
								<ValidationMessage For="@(() => newProduct.Image)" />
							</div>
							<button type="submit" class="btn addProductB">Add Product</button>
							<button type="button" class="btn addProductCancelB" @onclick="HideAddProductForm">Cancel</button>
						</EditForm>
					</div>
				</div>
			</div>
		}
		@* order erstellen *@
		@if (IsShowOrder)
		{
			<div class="overlay">
				<div class="overlayAddForm">
					@* address *@
					<h3>Lieferadresse: </h3>
					@if (selectedAddress == false)
					{
						<EditForm Model="@newAddress" OnValidSubmit="HandleAddressSubmit">
							<DataAnnotationsValidator />
							<div class="form-group">
								<label>Vorname</label>
								<InputText class="form-control" @bind-Value="newAddress.FirstName" />
								<ValidationMessage style="color:red;" For="@(() => newAddress.FirstName)" />
							</div>
							<div class="form-group">
								<label>Nachname</label>
								<InputText class="form-control" @bind-Value="newAddress.LastName" />
								<ValidationMessage style="color:red;" For="@(() => newAddress.LastName)" />
							</div>
							<div class="form-group">
								<label>Tel.</label>
								<InputText class="form-control" @bind-Value="newAddress.Phone" />
								<ValidationMessage style="color:red;" For="@(() => newAddress.Phone)" />
							</div>
							<div class="form-group">
								<label>Straße</label>
								<InputText class="form-control" @bind-Value="newAddress.Street" />
								<ValidationMessage style="color:red;" For="@(() => newAddress.Street)" />
							</div>
							<div class="form-group">
								<label>Postleitzahl</label>
								<InputText class="form-control" @bind-Value="newAddress.ZipCode" />
								<ValidationMessage style="color:red;" For="@(() => newAddress.ZipCode)" />
							</div>
							<div class="form-group">
								<label>Stadt</label>
								<InputText class="form-control" @bind-Value="newAddress.City" />
								<ValidationMessage style="color:red;" For="@(() => newAddress.City)" />
							</div>
							<div class="form-group">
								<label>Land</label>
								<InputText class="form-control" @bind-Value="newAddress.Country" readonly />
							</div>
							<div class="addAddressClassB">
								<button type="submit" class="btn addAddressB">Adresse Hinzufügen</button>
							</div>
						</EditForm>
					}
					@if (selectedAddress == true)
					{
						<InputRadioGroup @bind-Value="selectedAddressId" class="addressRadio">
							<div class="addressOption">
								<label>
									<InputRadio Value="@newAddress.Id" />
									@newAddress.FirstName @newAddress.LastName - @newAddress.Street, @newAddress.ZipCode @newAddress.City
								</label>
							</div>
						</InputRadioGroup>
					}
					@* Zahlung Methode *@
					<div class="paymentMethodOption">
						<InputRadioGroup Value="@selectedPaymentId" ValueChanged="@((int val) => OnPaymentChanged(val))" ValueExpression="() => selectedPaymentId">
							@for (int i = 0; i < orderService.DownloadedPaymentMethods.Count; i++)
							{
								if (orderService.DownloadedPaymentMethods[i].Id == 1 || orderService.DownloadedPaymentMethods[i].Id == 2 ||
						orderService.DownloadedPaymentMethods[i].Id == 5)
								{
									var paymentMethod = orderService.DownloadedPaymentMethods[i];
									<label>
										<InputRadio Value="@paymentMethod.Id" />
										@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? paymentMethod.Description_ar : paymentMethod.Description_de)
									</label>
								}
							}
						</InputRadioGroup>
					
					</div>
					@* Discount Code *@
					<div class="discountClass">
						<label>Hast du Rabatt Code?</label>
						<div class="input-group d-flex gap-2 mb-1">
							<InputText class="form-control" @bind-Value="discountCode.Code" />
							<button type="button" class="btn btn-primary" @onclick="OnCode">
								@if (IsDiscountCodeLoading)
								{
									<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
								}
								else
								{
									<span>Code eingeben</span>
								}
							</button>
						</div>
						@{
							string message = null!;
							if (discountCode.Message != null && !string.IsNullOrEmpty(discountCode.Message))
							{
