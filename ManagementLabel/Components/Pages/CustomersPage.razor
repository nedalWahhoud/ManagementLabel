@page "/customers"
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@if (IsLoading)
{
	<div class="w-100 card-body text-center text-info">
		Lädt...
	</div>
}
else
{
<div class="main" @onclick="OnMainDiv">
	<h3>Kunden</h3>
	<div class="TopContiner">
		<button class="btn btn-success" @onclick="NewCustomer">
			➕ Add neue Customer
		</button>
		<select class="DistributionLinesDropdown" @bind="selectedDistributionLineId" @bind:after="AfterDistributionLineChanged" @onfocus="OnDistributionLineFocus">
			<option value="0">Alle</option>
			@foreach (var distributionLine in distributionLinesService.DownloadedDistributionLines)
			{
				<option value="@distributionLine.Id">@distributionLine.LineName</option>
			}
		</select>
	</div>
	@{
		List<Customers> customersToDisplay = customersService.DownloadedCustomers;
		if (FilteredCustomers != null)
		{
			customersToDisplay = FilteredCustomers;
		}

		if (customersToDisplay == null || !customersToDisplay.Any())
		{
			<div class="d-flex justify-content-center align-items-center"
			style="min-height: 60vh;">
				<p class="text-muted fs-5">
					Keine Customer gefunden.
				</p>
			</div>
		}
		else
		{
			<table class="table table-bordered table-hover">
				<tr>
					<th>Id</th>
					<th>Na-De</th>
					<th>Na-Ar</th>
					<th>Anschrift</th>
					<th>Koordinaten</th>
					<th>Tel.</th>
					<th>E-Mail</th>
					<th>No-De</th>
					<th>No-Ar</th>
					<th>Richtung</th>
					<th>Ha-Nu</th>
					<th>PIN</th>
				</tr>
				<tbody>
					@foreach (var customer in customersToDisplay)
					{
						<tr @oncontextmenu:preventDefault="true"
						@oncontextmenu="@(e => OnSelectRow(customer, e))"
						@onpointerdown="(e) => OnTouchStart(customer, e)"
						@onpointermove="OnTouchMove"
						@onpointerup="OnTouchEnd"
						@onclick="(e)=> OnSelectRow(customer,e)"
						class="@(selectedCustomer != null && selectedCustomer.Id == customer.Id ? "selected" : "")">
							<td>@customer.Id</td>
							<td>@customer.Name_de</td>
							<td>@customer.Name_ar</td>
							<td>
								@customer.Street @customer.BuildingNumber<br />
								@customer.PostalCode @customer.City 
							</td>
							<td>
								La: @customer.Latitude <br/>
								Lo: @customer.Longitude
							</td>
							<td>@customer.PhoneNumber</td>
							<td>@customer.Email</td>
							<td>@customer.Notes_de</td>
							<td>@customer.Notes_ar</td>
							<td>
								@(customer.DistributionLine?.LineName ?? "Null DistributionLine")
							</td>
							<td>@customer.StopNumber</td>
							<td>@customer.PIN</td>

							<td>
								<button class="btn btn-sm btn-warning me-1"
								@onclick="() => Edit(customer)" disabled="@IsProcessing.Item1">
									Bearbeiten
								</button>
								<button class="btn btn-sm btn-danger"
								@onclick="() => Delete(customer.Id)" disabled="@IsProcessing.Item1">
									@if (IsProcessing.Item1 && IsProcessing.Item2 == customer.Id)
									{
										<span class="spinner-border spinner-border-sm"
										role="status"
										aria-hidden="true"></span>
									}
									else
									{
										<span>Löschen</span>
									}
								</button>
							</td>

						</tr>
					}
					@if (showContextMenu && selectedCustomer != null && IsProcessing.Item1 == false)
					{
						<div class="contextMenu"
						style="position: fixed; top:@menuYpx; left:@menuXpx;"
						@onclick:stopPropagation="true">
							<ul>
								<li @onclick="() => viaWhatasappShare(selectedCustomer)"><i class="bi bi-whatsapp me-1"></i> Teilen über WhatsApp</li>
								<li @onclick="() => OnDebts(selectedCustomer.Id)"><i class="bi bi-cash-stack me-3"></i> Schulden</li>
							</ul>
						</div>
					}
				</tbody>
			</table>
		}
	}
</div>
@if (IsAdding)
{
	<ManagementLabel.Components.Layout.OverlayEditAddCustomers customer="new Customers()" Action="Add" OnHandel="HandleEditAddDistributionLine" />
}
else if (IsEditing)
{
	<ManagementLabel.Components.Layout.OverlayEditAddCustomers customer="EditingCustomer" Action="Edit" OnHandel="HandleEditAddDistributionLine" />
}
}
@code {
	private bool IsAdding = false;
	private bool IsEditing = false;
	private Customers EditingCustomer = null!;
	Task taskDistributionLines = Task.CompletedTask;
	private bool IsLoading = true;
	protected async override Task OnInitializedAsync()
	{
		await customersService.GetAllCustomers();
		taskDistributionLines = distributionLinesService.GetAllDistributionLines();


		selectedDistributionLineId = await LocalStorage.GetItemAsync<int>("selectedDistributionLineId");
		if (selectedDistributionLineId > 0)
		{
			if (!taskDistributionLines.IsCompleted)
				await taskDistributionLines;

			await AfterDistributionLineChanged();
		}

		IsLoading = false;
	}
	private void NewCustomer()
	{
		IsAdding = true;
	}
	private void Edit(Customers customers)
	{
		EditingCustomer = new Customers
			{
				Id = customers.Id,
				Name_de = customers.Name_de,
				Name_ar = customers.Name_ar,
				Street = customers.Street,
				BuildingNumber = customers.BuildingNumber,
				PostalCode = customers.PostalCode,
				City = customers.City,
				Latitude = customers.Latitude,
				Longitude = customers.Longitude,
				PhoneNumber = customers.PhoneNumber,
				Email = customers.Email,
				Notes_de = customers.Notes_de,
				Notes_ar = customers.Notes_ar,
				DistributionLineId = customers.DistributionLineId,
				DistributionLine = customers.DistributionLine,
				StopNumber = customers.StopNumber

			};

		IsEditing = true;
	}
	private (bool, int) IsProcessing = (false, 0);
	private async Task Delete(int id)
	{
		if (id <= 0)
		{
			await JS.InvokeVoidAsync("showAlert", "Please select a DistributionLine");
			return;
		}
		IsProcessing = (true, id);
		var resultConfirm = await JS.InvokeAsync<bool>("confirm", $"Möchten Sie das DistributionLine mit der ID {id} wirklich löschen?");
		if (resultConfirm)
		{
			var result = await customersService.DeleteCustomer(id);
			if (!result.Result)
			{
				await JS.InvokeVoidAsync("showAlert", result.Message);
			}

		}
		IsProcessing = (false, id);
	}
	private void HandleEditAddDistributionLine(string action)
	{
		if (action == "Add")
		{
			IsAdding = false;
		}
		else
		{
			IsEditing = false;
			EditingCustomer = null!;
		}
	}
	// filter 
	private List<Customers> FilteredCustomers = null!;
	private int selectedDistributionLineId = 0;
	private async Task AfterDistributionLineChanged()
	{
		if (selectedDistributionLineId > 0)
		{
			if (customersService.DownloadedCustomers.Count > 0)
			{
				FilteredCustomers = customersService.GetCustomerByDistributionLineIdLocal(selectedDistributionLineId);
			}
		}
		else
		{
			FilteredCustomers = null!;
		}

		// save the selected category id in local storage
		await LocalStorage.SetItemAsync("selectedDistributionLineId", selectedDistributionLineId);
	}
	private async Task OnDistributionLineFocus()
	{
		if (!taskDistributionLines.IsCompleted)
		{
			await taskDistributionLines;
		}
	}
	// Menu recht klicken
	private bool showContextMenu = false;
	private double menuX;
	private double menuY;
	private string menuXpx => $"{menuX}px";
	private string menuYpx => $"{menuY}px";
	private System.Timers.Timer? longPressTimer;
	private double startX, startY;
	private bool isDragging = false;
	private Customers? selectedCustomer;

	private void OnSelectRow(Customers customer, MouseEventArgs e)
	{
		if (e.Button == 2) // right click
		{
			selectedCustomer = customer;
			menuX = e.ClientX;
			menuY = e.ClientY;
			showContextMenu = true;
		}
		selectedCustomer = customer;
	}
	private void OnTouchStart(Customers customer, PointerEventArgs e)
	{
		startX = e.ClientX;
		startY = e.ClientY;
		isDragging = false;

		//Timer für langes Drücken (eine halbe Sekunde)
		longPressTimer = new System.Timers.Timer(600);
		longPressTimer.Elapsed += (_, __) =>
		{
			if (!isDragging) // nur wenn nicht gezogen wird
			{
				InvokeAsync(() =>
				{
					selectedCustomer = customer;
					menuX = e.ClientX;
					menuY = e.ClientY;
					showContextMenu = true;
					StateHasChanged();
				});
			}
			longPressTimer?.Stop();
		};
		longPressTimer.AutoReset = false;
		longPressTimer.Start();
		// select die Row
		selectedCustomer = customer;
	}
	private void OnTouchMove(PointerEventArgs e)
	{
		// إذا تحرك الإصبع أكثر من 10px → اعتبره سحب
		if (Math.Abs(e.ClientX - startX) > 10 || Math.Abs(e.ClientY - startY) > 10)
		{
			isDragging = true;
			longPressTimer?.Stop();
		}
	}
	private void OnTouchEnd(PointerEventArgs e)
	{
		// Wenn der Benutzer seinen Finger schnell anhebt → das Menü öffnet sich nicht
		longPressTimer?.Stop();
	}
	/* teilen Whats app */
	private async Task viaWhatasappShare(Customers customer)
	{
		var result = await whatsAppService.SendCustomerInfo(customer);
		if (!result.Result)
		{
			await JS.InvokeVoidAsync("showAlert", result.Message);
		}
		showContextMenu = false;
	}
	/* Schulden */
	private void OnDebts(int customerId)
	{
		NavigationManager.NavigateTo($"/debt{customerId}");
		showContextMenu = false;
	}
	private void OnMainDiv()
	{
		if (showContextMenu)
			showContextMenu = false;
	}
}
