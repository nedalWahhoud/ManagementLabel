<div class="overlay">
	<div class="standardOverlayForm">
		<EditForm Model="@DistributionLine" OnValidSubmit="Save">
			<DataAnnotationsValidator />
			<div class="overlayField">
				<label>Nameline</label>
				<InputText class="form-control" @bind-Value="DistributionLine.LineName" />
				<ValidationMessage For="@(() => DistributionLine.LineName)" />
			</div>
			<div class="overlayField">
				<label>line Beschreibung</label>
				<InputText class="form-control" @bind-Value="DistributionLine.Description" />
				<ValidationMessage For="@(() => DistributionLine.Description)" />
			</div>
			<div class="mt-3">
				<button class="btn btn-primary me-2" disabled="@IsProcessing">
					@if (IsProcessing)
					{
						<span class="spinner-border spinner-border-sm"
						role="status"
						aria-hidden="true"></span>
					}
					else
					{
						<span>Speichern</span>
					}
				</button>
				<button class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
			</div>
		</EditForm>
	</div>
</div>

@code {
	[Parameter]
	public DistributionLines DistributionLine { get; set; } = new DistributionLines();
	[Parameter]
	public string action { get; set; } = string.Empty;
	[Parameter]
	public EventCallback<string> OnHandel { get; set; }

	private bool IsProcessing = false;
	private async Task Save()
	{
		IsProcessing = true;
		if (action == "Add")
		{
			var result = await distributionLinesService.AddDistributionLineAsync(DistributionLine);
			if (result.Result)
			{
				DistributionLine = null!;
				await OnHandel.InvokeAsync(action);
			}
			else
				await JS.InvokeVoidAsync("window.alert", result.Message);
		}
		else
		{
			DistributionLines? currentDistributionLine = distributionLinesService.DownloadedDistributionLines.FirstOrDefault(c => c.Id == DistributionLine.Id);
			if (currentDistributionLine != null)
			{
				bool isEdited = distributionLinesService.IsEdited(currentDistributionLine, DistributionLine);
				if (isEdited)
				{
					var result = await distributionLinesService.UpdateDistributionLineAsync(DistributionLine);
					if (result.Result)
					{
						DistributionLine = new();
						await OnHandel.InvokeAsync(action);
					}
					else
						await JS.InvokeVoidAsync("window.alert", result.Message);
				}
				else
					await JS.InvokeVoidAsync("window.alert", "Nichts hat sich geändert");
			}
			else
				await JS.InvokeVoidAsync("window.alert", "keine currentGroup gefunden");
		}
		IsProcessing = false;
	}
	private async void Cancel()
	{
		DistributionLine = new DistributionLines();
		await OnHandel.InvokeAsync(action);
	}
}
