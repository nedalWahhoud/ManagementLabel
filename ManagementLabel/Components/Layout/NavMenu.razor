@rendermode InteractiveServer
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">ManagementLabel</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" style="height: 50px;" href="/" Match="NavLinkMatch.All">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <span class="bi bi-box-seam fs-3"></span>
                        </span>
                        <span class="ms-2">Produkte</span>
                    </NavLink>
                    <NavLink class="nav-link d-flex align-items-center" style="height: 50px;" @onclick="OnOrder" >
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <span class="bi bi-bag-check fs-3"></span>
                            @* noch nicht fertige Bestellungen (Gelb) *@
                            @if (orderService.NotFinishedOrderCount > 0)
                            {
                                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger">
                                    @orderService.NotFinishedOrderCount
                                </span>
                            }
                        </span>
                        <span class="ms-2">Bestellungen</span>
                    </NavLink>
                    <NavLink class="nav-link d-flex align-items-center" style="height: 50px;" @onclick="OnDiscountCode">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-tag fs-3 "></i>
                        </span>
                        <span class="ms-2">Discount</span>
                    </NavLink>
                    <NavLink class="nav-link d-flex align-items-center" style="height: 50px;" @onclick="OnCategories">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-grid-3x3-gap fs-3"></i>
                        </span>
                        <span class="ms-2">Categories</span>
                    </NavLink>
                    <NavLink class="nav-link d-flex align-items-center" style="height: 50px;" @onclick="OnGroupProduct">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-stack fs-3"></i>
                        </span>
                        <span class="ms-2">Produktgruppe</span>
                    </NavLink>
                    <NavLink class="nav-link d-flex align-items-center" style="height: 50px;" @onclick="OnCarousel">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-display fs-3"></i>
                        </span>
                        <span class="ms-2">Bildkarussell</span>
                    </NavLink>
                </div>
                <!-- Spacer to push logout to bottom -->
                <div style="flex-grow: 1;"></div>

                <!-- LogOut at bottom -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" @onclick="HandleLogout">
                        <span class="bi bi-box-arrow-left fs-3 me-2 d-inline-block" style="line-height: 1;"></span>
                        <span class="ms-2">Logout</span>
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> LogIn
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {

    private int OpenOrderCount { get; set; } = 0;
    protected override void OnInitialized()
    {
        // event handler for cart changes
        orderService.OnChange += HandleOpenOrderCountChange;
    }

    private void HandleOpenOrderCountChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
    }
    // order 
	private void OnOrder()
	{
		NavigationManager.NavigateTo("/order",false);
	}
	// discount code
	private void OnDiscountCode()
    {
		NavigationManager.NavigateTo("/discountcode", false);
	}
    // group product
	private void OnGroupProduct()
	{
		NavigationManager.NavigateTo("/groupproduct", false);
	}
    // carousel
	private void OnCarousel()
    {
        NavigationManager.NavigateTo("/carousel", false);
	}
    // categories
	private void OnCategories()
    {
        NavigationManager.NavigateTo("/categories", false);
	}
    public void Dispose()
    {
        orderService.OnChange -= HandleOpenOrderCountChange;
    }
}