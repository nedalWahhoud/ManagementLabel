@rendermode InteractiveServer
@implements IDisposable

 <AuthorizeView>
    <Authorized Context="authContext">
        <div class="top-row ps-3 navbar navbar-dark">
           <div class="container-fluid">
                <a class="navbar-brand" href="#">@authContext.User.Identity!.Name</a>
            </div>
        </div>
    </Authorized>
</AuthorizeView>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" style="height: 50px;" href="/" Match="NavLinkMatch.All">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <span class="bi bi-box-seam fs-3"></span>
                        </span>
                        <span class="ms-2">Produkte</span>
                    </NavLink>
                    <NavLink href="/order" class="nav-link d-flex align-items-center" style="height: 50px;">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <span class="bi bi-bag-check fs-3"></span>
                            @* noch nicht fertige Bestellungen (Gelb) *@
                            @if (orderService.NotFinishedOrderCount > 0)
                            {
                                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger">
                                    @orderService.NotFinishedOrderCount
                                </span>
                            }
                        </span>
                        <span class="ms-2">Bestellungen</span>
                    </NavLink>
                    <NavLink href="/discountcode" class="nav-link d-flex align-items-center" style="height: 50px;">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-tag fs-3 "></i>
                        </span>
                        <span class="ms-2">Discount</span>
                    </NavLink>
                    <NavLink href="/suppliers" class="nav-link d-flex align-items-center" style="height: 50px;">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-truck fs-3"></i>
                        </span>
                        <span class="ms-2">Lieferanten</span>
                    </NavLink>
                    <NavLink href="/categories" class="nav-link d-flex align-items-center" style="height: 50px;">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-grid-3x3-gap fs-3"></i>
                        </span>
                        <span class="ms-2">Categories</span>
                    </NavLink>
                    <NavLink href="/groupproduct" class="nav-link d-flex align-items-center" style="height: 50px;">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-stack fs-3"></i>
                        </span>
                        <span class="ms-2">Produktgruppe</span>
                    </NavLink>
                    <NavLink href="/carousel" class="nav-link d-flex align-items-center" style="height: 50px;">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-display fs-3"></i>
                        </span>
                        <span class="ms-2">Bildkarussell</span>
                    </NavLink>
                    <NavLink href="/distributionlines" class="nav-link d-flex align-items-center" style="height: 50px;">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-buildings fs-3"></i>
                        </span>
                        <span class="ms-2">Verteilungslinien</span>
                    </NavLink>
                    <NavLink href="/customers" class="nav-link d-flex align-items-center" style="height: 50px;" >
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-people fs-3"></i>
                        </span>
                        <span class="ms-2">Kunden</span>
                    </NavLink>
                    <NavLink href="/users" class="nav-link d-flex align-items-center" style="height: 50px;">
                        <span class="position-relative me-2 d-inline-block" style="line-height: 1;">
                            <i class="bi bi-person-circle fs-3"></i>
                        </span>
                        <span class="ms-2">Benutzern</span>
                    </NavLink>
                </div>
                <!-- Spacer to push logout to bottom -->
                <div style="flex-grow: 1;"></div>

                <!-- LogOut at bottom -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" @onclick="HandleLogout">
                        <span class="bi bi-box-arrow-left fs-3 me-2 d-inline-block" style="line-height: 1;"></span>
                        <span class="ms-2">Logout</span>
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> LogIn
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {

    private int OpenOrderCount { get; set; } = 0;
    protected override void OnInitialized()
    {
        // event handler for cart changes
        orderService.OnChange += HandleOpenOrderCountChange;
    }

    private void HandleOpenOrderCountChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await authService.Logout();
    }
    
    public void Dispose()
    {
        orderService.OnChange -= HandleOpenOrderCountChange;
    }
}