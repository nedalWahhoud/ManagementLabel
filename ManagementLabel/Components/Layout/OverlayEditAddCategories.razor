<div class="overlay">
	<div class="overlayEditAddForm">
		<h4>@(action == "Add" ? "Category hinzufügen" : "Category bearbeiten")</h4>
		<EditForm Model="@category" OnValidSubmit="Save">
			<DataAnnotationsValidator />
			<div class="formGroupAdd">
				<label>Name de</label>
				<InputText class="form-control" @bind-Value="category.Name_de" />
				<ValidationMessage For="@(() => category.Name_de)" />
			</div>
			<div class="formGroupAdd">
				<label>Name ar</label>
				<InputText class="form-control" @bind-Value="category.Name_ar" />
				<ValidationMessage For="@(() => category.Name_ar)" />
			</div>
			<div class="formGroupAdd">
				<label>Ab 18 Jahren</label>
		    	<InputCheckbox @bind-Value="category.Requires18Plus" />
				<ValidationMessage For="@(() => category.Requires18Plus)" />
			</div>
			<div class="formGroupAdd">
				<label>Is Aktiv</label>
				<InputCheckbox @bind-Value="category.IsAktiv" />
				<ValidationMessage For="@(() => category.IsAktiv)" />
			</div>
			<div class="mt-3">
				<button class="btn btn-primary me-2">
					@if (IsProcessing)
					{
						<span class="spinner-border spinner-border-sm"
						role="status"
						aria-hidden="true"></span>
					}
					else
					{
						@(action == "Add" ? "Category hinzufügen" : "Category updaten")
					}
				</button>
				<button class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
			</div>
		</EditForm>
	</div>
</div>

@code {
	[Parameter]
	public Categories category { get; set; } = new Categories();
	[Parameter]
	public string action { get; set; } = string.Empty;
	[Parameter]
	public EventCallback<string> OnHandel { get; set; }
	private bool IsProcessing = false;
	private async void Save()
	{
		IsProcessing = true;
		if (action == "Add")
		{
			var result = await categoryService.CreateCategory(category);
			if (result.Result)
			{
				category = null!;
				await OnHandel.InvokeAsync(action);
			}
			else
				await JS.InvokeVoidAsync("window.alert", result.Message);
		}
		else
		{
			// wenn category editiert wurde
			Categories? currentCategory = categoryService.DownloadedCategories.FirstOrDefault(c => c.Id == category.Id);
			if (currentCategory != null)
			{
				bool isEdited = categoryService.IsCategoryEdited(currentCategory, category);
				if (isEdited)
				{
					var result = await categoryService.UpdateCategoryAsync(category);
					if (result.Result)
					{
						category = null!;
						await OnHandel.InvokeAsync(action);
					}
					else
						await JS.InvokeVoidAsync("window.alert", result.Message);
				}
				else
					await JS.InvokeVoidAsync("window.alert", "Nichts hat sich geändert");
			}
			else
				await JS.InvokeVoidAsync("window.alert", "keine currentCategory gefunden");
		}

		IsProcessing = false;
		StateHasChanged();
	}
	private void Cancel()
	{
		category = new Categories();
		OnHandel.InvokeAsync(action);

	}
}
