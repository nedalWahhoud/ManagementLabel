@implements IDisposable

@if(GetProducts != null)
{
	<div class="overlay">
		<div class="overlayAddForm">
			<div class="productForm">
				<h3>@(Title ?? "Fehler")</h3>
				<EditForm Model="@GetProducts" OnValidSubmit="HandleSubmit">

					<DataAnnotationsValidator />
					<div class="formGroupAdd">
						<label for="Name">Product Name DE</label>
						<InputText id="Name" class="form-control" @bind-Value="GetProducts!.Name_de" />
						<ValidationMessage For="@(() => GetProducts.Name_de)" />
					</div>
					<div class="formGroupAdd">
						<label for="Description">Description DE</label>
						<InputText id="Description" class="form-control" @bind-Value="GetProducts.Description_de" />
						<ValidationMessage For="@(() => GetProducts.Description_de)" />
					</div>
					<div class="formGroupAdd">
						<label for="Name">اسم المنتج بل عربية</label>
						<InputText id="Name" class="form-control" @bind-Value="GetProducts!.Name_ar" />
						<ValidationMessage For="@(() => GetProducts.Name_ar)" />
					</div>
					<div class="formGroupAdd">
						<label for="Description">وصف المنتج بل عربية</label>
						<InputText id="Description" class="form-control" @bind-Value="GetProducts.Description_ar" />
						<ValidationMessage For="@(() => GetProducts.Description_ar)" />
					</div>
					<div class="formGroupAdd">
						<label for="category">Category</label>
						<InputSelect id="category" class="form-control" @bind-Value="GetProducts.CategoryId">
							<option value="0">Select Category</option>
							@foreach (var category in categoryService.DownloadedCategories)
							{
								<option value="@category.Id">@category.Name_de</option>
							}
						</InputSelect>
						<ValidationMessage For="@(() => GetProducts.CategoryId)" />
					</div>
					<div class="formGroupAdd">
						<label for="Quantity">Quantity</label>
						<InputNumber  min="0" class="form-control" @bind-Value="GetProducts.Quantity" @onfocus="@(e => SelectAllContent())" />
						<ValidationMessage For="@(() => GetProducts.Quantity)" />
					</div>
					<div class="formGroupAdd">
						<label for="PurchasePrice">Purchase Price</label>
						<InputNumber  min="0" class="form-control" @bind-Value="GetProducts.PurchasePrice" @onfocus="@(e => SelectAllContent())" />
						<ValidationMessage For="@(() => GetProducts.PurchasePrice)" />
					</div>
					<div class="formGroupAdd">
						<label for="SalePrice">Selling Price</label>
						<InputNumber min="0" class="form-control" @bind-Value="GetProducts.SalePrice" @onfocus="@(e => SelectAllContent())" />
						<ValidationMessage For="@(() => GetProducts.SalePrice)" />
					</div>
					<div class="formGroupAdd">
						<label for="MinimumStock">Minimum Stock</label>
						<InputNumber min="0" class="form-control" @bind-Value="GetProducts.MinimumStock" @onfocus="@(e => SelectAllContent())" />
						<ValidationMessage For="@(() => GetProducts.MinimumStock)" />
					</div>
					<div class="formGroupAdd">
						<label for="EXPDate">Expiration Date</label>
						<InputDate id="EXPDate" class="form-control" @bind-Value="GetProducts.EXPDate" />
						<ValidationMessage For="@(() => GetProducts.EXPDate)" />
					</div>
					<div class="formGroupAdd">
						<InputSelect id="category" class="form-control" @bind-Value="GetProducts.ManufacturerId">
							<option value="0">Select Manufacturer</option>
							@foreach (var Manufacturer in productService.DownloadedManufacturers!)
							{
								<option value="@Manufacturer.Id">@Manufacturer.Name</option>
							}
						</InputSelect>
						<ValidationMessage For="@(() => GetProducts.ManufacturerId)" />
					</div>
					<div class="formGroupAdd">
						<InputSelect class="form-control" @bind-Value="GetProducts.TaxRateId">
							<option value="0">Select Rate</option>
							@foreach (var rate in productService.DownloadedTaxRates)
							{
								<option value="@rate.Id">@rate.Rate</option>
							}
						</InputSelect>
						<ValidationMessage For="@(() => GetProducts.TaxRateId)" />
					</div>
					<div class="formGroupAdd">
						<InputSelect class="form-control" @bind-Value="GetProducts.ProductGroupID">
							<option value="0">wählen Product Gruppe aus</option>
							@foreach (var groupProduct in productGroupService.DownloadedproductGroups)
							{
								<option value="@groupProduct.Id">@groupProduct.GroupName_de</option>
							}
						</InputSelect>
						<ValidationMessage For="@(() => GetProducts.ProductGroupID)" />
					</div>
					<div class="formGroupAdd">
						<label for="ProductGroup">Versandfähig</label>
						<InputCheckbox @bind-Value="GetProducts.IsShippable" />
						<ValidationMessage For="@(() => GetProducts.IsShippable)" />
					</div>
					<div class="formGroupAdd">
						@if (GetProducts.ProductDiscount != null)
						{
							<label for="ImAngebot">Im Angebot</label>
							<div class="card p-3 mb-3 gap-1">
								<InputNumber class="form-control" min="0" @bind-Value="GetProducts.ProductDiscount.DiscountedPrice" @onfocus="@(e => SelectAllContent())" />
								<ValidationMessage For="@(() => GetProducts!.ProductDiscount.DiscountedPrice)" />
								<div class="row">
									<div class="col-md-6">
										<InputDate class="form-control" @bind-Value="GetProducts.ProductDiscount.StartDate" />
										<ValidationMessage For="@(() => GetProducts!.ProductDiscount.StartDate)" />
									</div>
									<div class="col-md-6">
										<InputDate class="form-control" @bind-Value="GetProducts.ProductDiscount.EndDate" />
										<ValidationMessage For="@(() => GetProducts!.ProductDiscount.EndDate)" />
									</div>
								</div>
							</div>
						}
					</div>
					<div class="formGroupAdd">
						<div class="imageUpload">
							<InputFile id="Image" class="form-control" OnChange="ImageUpload" />
							@if (GetProducts.ProductImages != null && GetProducts.ProductImages.Count > 0)
							{
								ProductImages mainImage = GetProducts.ProductImages.FirstOrDefault(i => i.IsMain)!;
								string imgScr = string.Empty;
								if (!string.IsNullOrEmpty(mainImage.ImageUrlLocal))
								{
									imgScr = mainImage.ImageUrlLocal;
								}
								else
								{
									imgScr = productImagesService.GetProductImageUrl(mainImage);

								}
								<img src="@imgScr"
								alt="Product Image"
								class="previewImage" />
								<ValidationMessage For="@(() => GetProducts!.ProductImages)" />
							}
						</div>
					</div>
					<button type="submit" class="btn addProductB">
						@if (IsProcessing)
						{
							<span class="spinner-border spinner-border-sm"
							role="status"
							aria-hidden="true"></span>
						}
						else
						{
							@(ButtonName ?? "Fehler")
						}					
					</button>
					<button type="button" class="btn addProductCancelB" @onclick="CancelSubmit">Abbrechen</button>
				</EditForm>
			</div>
		</div>
	</div>
}
@code {
	[Parameter]
	public string Title { get; set; } = string.Empty;
	[Parameter]
	public string ButtonName { get; set; } = null!;
	[Parameter]
	public Products GetProducts { get; set; } = null!;
	[Parameter]
	public string Action { get; set; } = string.Empty;
	[Parameter]
	public Users? user { get; set; }
	[Parameter]
	public EventCallback<(Products product, string Action, bool ActionState)> OnHandel { get; set; }


	private bool IsProcessing = false;
	protected override void OnInitialized()
	{
		// get default image for add action, and Initialize die ProductDiscount
		if (Action == "Add")
		{
			GetProducts.ProductImages.Add(productImagesService.GetDefaultImage());
		}
	}

	private async Task HandleSubmit()
	{
		IsProcessing = true;
		if (Action == "Edit")
		{
			// wenn null 
			if (GetProducts == null)
			{
				await JS.InvokeVoidAsync("window.alert", "Nichts geändert");
				IsProcessing = false;
				return;
			}
			// wenn  nicht edited
			Products? currentProduct = productService.DownloadedProduct.Find(p => p.Id == GetProducts.Id);
			bool isEdited = productService.IsEditedProduct(currentProduct!, GetProducts);
			if (!isEdited)
			{
				await JS.InvokeVoidAsync("window.alert", "Nichts geändert");
				IsProcessing = false;
				return;
			}

			var result = await productService.UpdateProductAsync(GetProducts);
			if (result.Result)
			{
				// get edited Product
				var editedProduct = await productService.GetProductByIdAsync(GetProducts.Id);
				GetProducts = editedProduct;

				// initaialize the caritem for this new product
				GetProducts.InitializeCartItem(0);

				// Update the product in the list
				int index = productService.DownloadedProduct!.FindIndex(p => p.Id == GetProducts.Id);
				productService.DownloadedProduct[index] = GetProducts!; // Update the product in the list

				// Benachrichtigen Sie die Vater Komponente über das Update
				await OnHandel.InvokeAsync((GetProducts, Action, false));
			}
			else
				await JS.InvokeVoidAsync("window.alert", result.Message!);
		}
		else if (Action == "Add")
		{

			var isValid = productService.IsValidProduct(GetProducts!);
			if (isValid.Result == false)
			{
				await JS.InvokeVoidAsync("window.alert", isValid.Message!);
				return;
			}

			// add user, the new Product added
			GetProducts!.UserId = user?.Id ?? 0;

			// löschen die ImageUrls bevor das Produkt hinzugefügt wird, weil wir brauchen die imageUrl nicht, da wird in Api in eine Datei gespeichert, und die URL wird generiert
			GetProducts.ProductImages.ToList().ForEach(i => i.ImageUrl = string.Empty);

			// Perform your logic to add the product to the database
			var result = await productService.AddProductAsync(GetProducts!);
			// Check if the result is successful and Get the ID returned by the database
			if (result.Result)
			{
				// get neue Products von Database um auch die Id von Image und ProductDiscount mitzuholen
				var editedProduct = await productService.GetProductByIdAsync(result.NewId ?? 0);
				if (editedProduct == null)
				{
					await JS.InvokeVoidAsync("window.alert", "Fehler bei Holung des neue Product von Database");
					IsProcessing = false;
					return;
				}
				GetProducts = editedProduct;

				// initaialize the caritem for this new product
				GetProducts.InitializeCartItem(0);

				// Add the new product to the products list
				productService.DownloadedProduct.Insert(0, GetProducts!); // Add the new product to the products list

				// Benachrichtigen Sie die Vater Komponente über das Update
				await OnHandel.InvokeAsync((GetProducts, Action, false));
			}
			else
				await JS.InvokeVoidAsync("window.alert", result.Message!);
		}
		IsProcessing = false;
	}
	private void CancelSubmit()
	{
		GetProducts = null!;
		OnHandel.InvokeAsync((GetProducts, Action,false));
	}
	// image 
	private async Task ImageUpload(InputFileChangeEventArgs e)
	{
		if (e.File == null) return;
		Microsoft.AspNetCore.Components.Forms.IBrowserFile imageFile = e.File;
		try
		{
			if (Action == "Add")
			{
				byte[] imageBytes = await productImagesService.GetImageBytesAndCheckSize(imageFile);

				string imageUrl = string.Empty;
				if (imageBytes != null)
				{
					string base64 = Convert.ToBase64String(imageBytes);
					imageUrl = $"data:image/jpeg;base64,{base64}";
					var mainImage = GetProducts.ProductImages.FirstOrDefault(i => i.IsMain);
					if (mainImage == null)
					{
						mainImage = new ProductImages
							{
								ProductId = 0,
								ImageUrlLocal = imageUrl,
								IsMain = true,
								ImageBytes = imageBytes
							};

						GetProducts.ProductImages.Add(mainImage);
					}
					else
					{
						mainImage.ImageUrlLocal = imageUrl;
						mainImage.ImageBytes = imageBytes;
					}
				}
				else
				{
					ProductImages mainProductImages = productImagesService.GetDefaultImage();
					GetProducts.ProductImages.Add(mainProductImages);
					return;
				}
			}
			else
			{
				byte[] imageBytes = await productImagesService.GetImageBytesAndCheckSize(imageFile);

				var mainImage = GetProducts.ProductImages.FirstOrDefault(i => i.IsMain);

				if (mainImage != null)
				{
					string base64 = Convert.ToBase64String(imageBytes);
					string imageUrl = $"data:image/jpeg;base64,{base64}";
					mainImage.ProductId = GetProducts.Id;
					mainImage.ImageUrlLocal = imageUrl;
					mainImage.ImageBytes = imageBytes;
					mainImage.LastModified = DateTime.UtcNow;
				}
			}
		}
		catch (Exception ex)
		{
			await JS.InvokeVoidAsync("window.alert", $"Error uploading image: {ex.Message}");
		}
	}
	// select all content in input when focus
	private async Task SelectAllContent()
	{
		try
		{
			// um sicherzustellen, dass der Browser den Fokussierungsprozess abgeschlossen hat
			await Task.Delay(10);
			await JS.InvokeVoidAsync("eval", "document.querySelector('.form-control:focus').select()");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error selecting input text: {ex.Message}");
		}
	}
	
	public void Dispose()
	{
		GetProducts = null!;
	}
}
