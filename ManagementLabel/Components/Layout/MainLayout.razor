@inherits LayoutComponentBase

@if (!isRended)
{
    <div class="lodingContainer">
        <p>wird geladen... </p>
    </div>
}
else
{
<div class="page">
    <AuthorizeView>
      <Authorized>
        <div class="sidebar">
            <NavMenu />
        </div>
      </Authorized>
    </AuthorizeView>
    <main>
        <article class="content px-4">
          @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
}
@code {

    private bool isRended = false;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
			// Initialize the orderService to start count funktion of openOrders 
            orderService.InitializeAsync();

            isRended = true;
            StateHasChanged();
        }
    }
}