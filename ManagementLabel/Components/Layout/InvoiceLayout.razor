@if (IsInvoiceVisible && invoice != null)
{
	<div class="overlay">
		<div class="overlayFormInvoice">
			<div class="header">
				<button class="btn btn-close" @onclick="CloseInvoice"></button>
				<div class="dropdown">
					<button class="btn btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown">
						⋮
					</button>
					<ul class="dropdown-menu">
						<li style="cursor:pointer"><a class="dropdown-item" @onclick="() => OnSaveInvoice(invoice)">Speichern</a></li>
					</ul>
				</div>
			</div>
			<div id="InvoiceBox" class="InvoiceBox">
				<div class="InvoiceContent">
					<h2>@invoice.projectInfo.Value.Name</h2>
					<div class="InvoiceFirstPart">
						<div class="InvoiceAddress">
							<span class="SenderAddress">@invoice.projectInfo.Value.Name @invoice.projectInfo.Value.Address</span>
							<span>@invoice.order.Address?.FirstName @invoice.order.Address?.LastName</span>
							<span>@invoice.order.Address?.Street</span>
							<span>@invoice.order.Address?.ZipCode @invoice.order.Address?.City</span>
						</div>
						<div class="InvoiceContact">
							<span>E-mail: @projectInfo.Value.Email</span>
							<span>Tel.: @projectInfo.Value.Phone</span>
						</div>
					</div>
					<div class="InvoiceSecondPart">
						<span>Rechnung</span>
						<p class="InvoiceDetails">
							<span><label>Rechnungsnummer</label>@invoice.InvoceeNumber</span>
							<span><label>Rechnungsdatum</label>@DateTime.Today.ToString("dd.MM.yyyy")</span>
							<span><label>Order Id</label>@invoice.order.Id</span>
							<span><label>Ordersdatum</label>@invoice.order.OrderDate.ToString("dd.MM.yyyy HH:mm")</span>
						</p>
					</div>
					<div class="OrderDetails">
						<table class="tableOrderDetails">
							<thead>
								<tr>
									<th>Pos.</th>
									<th>Produkt</th>
									<th>Menge</th>
									<th>Einzelpreis</th>
									<th>Steuer</th>
									<th>Preis</th>
								</tr>
							</thead>
							<tbody>

								@{
									double TotalGross = 0;
									double GetTaxAmountRate19 = 0;
									double TotalPriceOfTaxRate19 = 0;
									double GetTaxAmountRate7 = 0;
									double TotalPriceOfTaxRate7 = 0;
									for (int i = 0; i < invoice.order.OrderItems.Count; i++)
									{
										var item = invoice.order.OrderItems[i];
										var itemPreis = item.UnitPrice * item.Quantity;
										TotalGross += itemPreis;
										if (item.Product?.TaxRate != null && item.Product?.TaxRate?.Rate == 19)
										{
											if (invoice.order.DiscountCode != null)
											{
												TotalPriceOfTaxRate19 += itemPreis - ((itemPreis / 100) * invoice.order.DiscountCode.DiscountPercentage);
											}
											else if (invoice.order.DiscountCategory != null)
											{
												TotalPriceOfTaxRate19 += itemPreis - ((itemPreis / 100) * invoice.order.DiscountCategory.DiscountPercentage);
											}
											else
												TotalPriceOfTaxRate19 += itemPreis;
										}
										else if (item.Product?.TaxRate != null && item.Product?.TaxRate?.Rate == 7)
										{
											if (invoice.order.DiscountCode != null)
											{
												TotalPriceOfTaxRate7 += itemPreis - ((itemPreis / 100) * invoice.order.DiscountCode.DiscountPercentage);
											}
											else if (invoice.order.DiscountCategory != null)
											{
												TotalPriceOfTaxRate7 += itemPreis - ((itemPreis / 100) * invoice.order.DiscountCategory.DiscountPercentage);
											}
											else
												TotalPriceOfTaxRate7 += itemPreis;
										}
										<tr>
											<td>@(i + 1)</td>
											<td>@(item.Product?.Name_de ?? "Fehler")</td>
											<td>@item.Quantity</td>
											<td>@item.UnitPrice.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>
											<td>@(item.Product?.TaxRate?.Rate != null ? item.Product.TaxRate.Rate : "")</td>
											<td>@(itemPreis.ToString("C", new System.Globalization.CultureInfo("de-DE")))</td>
										</tr>
									}
									@* Rabbat *@
									@if (invoice.order.DiscountCode != null)
									{
										var discountDetails = invoiceService.GetDetailsDiscountCode(invoice.order);

										<tr style="border-top: 1px solid #cccccc;">
											<td colspan="5" style="padding-top:20px;" class="text-end"><strong>Rabatt:</strong></td>
											<td colspan="1" style="padding-top:20px;">@($"{discountDetails.DiscountPercentage}% ({discountDetails.DiscountValue:C})")</td>
										</tr>
										@* Den Rabatt vom Betrag abziehen *@
										TotalGross -= discountDetails.DiscountValue;
									}
									else if (invoice.order.DiscountCategory != null)
									{
										var discountDetails = invoiceService.GetDetailsDiscountCategory(invoice.order);

										<tr style="border-top: 1px solid #cccccc;">
											<td colspan="5" style="padding-top:20px; padding-bottom:10px;" class="text-end"><strong>Rabatt:</strong></td>
											<td colspan="1" style="padding-top:20px; padding-bottom:10px;">@($"K.: {discountDetails.categoryName} \n{discountDetails.DiscountPercentage}% ({discountDetails.DiscountValue:C})")</td>
										</tr>
										@* Den Rabatt vom Betrag abziehen *@
										TotalGross -= discountDetails.DiscountValue;
									}
									else
									{
										<tr style="border-top: 1px solid #cccccc;">
											<td colspan="5" style="padding-top:20px; padding-bottom:10px;" class="text-end"><strong>Rabatt:</strong></td>
											<td colspan="1" style="padding-top:20px; padding-bottom:10px;">0 €</td>
										</tr>
									}
									@* Versandkosten *@
									<tr>
										<td colspan="5" class="text-end"><strong>Versandskosten:</strong></td>
										<td colspan="1">@invoice.order?.ShippingCost.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>
									</tr>
									@* Preis *@
									<tr>
										<td colspan="5" class="text-end"><strong>Preis:</strong></td>
										<td colspan="1">@(TotalGross.ToString("C", new System.Globalization.CultureInfo("de-DE")))</td>
									</tr>
									@* Gesamtbrutto *@
									<tr>
										<td colspan="5" class="text-end"><strong>Gesamtbrutto:</strong></td>
										<td colspan="1">@((TotalGross + invoice.order?.ShippingCost ?? 0).ToString("C", new System.Globalization.CultureInfo("de-DE")))</td>
									</tr>
									@* Steuer *@
									GetTaxAmountRate19 = (TotalPriceOfTaxRate19 / 100) * 19;
									GetTaxAmountRate7 = (TotalPriceOfTaxRate7 / 100) * 7;

									<tr>
										<td colspan="5" class="text-end"><strong>MwSt. 19% von @TotalPriceOfTaxRate19.ToString("C", new System.Globalization.CultureInfo("de-DE")) :</strong></td>
										<td colspan="1">@GetTaxAmountRate19.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>
									</tr>
									<tr>
										<td colspan="5" class="text-end"><strong>MwSt. 7% von @TotalPriceOfTaxRate7.ToString("C", new System.Globalization.CultureInfo("de-DE")) :</strong></td>
										<td colspan="1">@GetTaxAmountRate7.ToString("C", new System.Globalization.CultureInfo("de-DE"))</td>
									</tr>
									@* Netto *@
									<tr>
										<td colspan="5" style="padding-top:10px;" class="text-end"><strong>Gesamtnetto:</strong></td>
										<td colspan="1" style="padding-top:10px;">@((TotalGross - (GetTaxAmountRate19 + GetTaxAmountRate7)).ToString("C", new System.Globalization.CultureInfo("de-DE")))</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
				<div class="OrderFooter">
					<p class="RightPart">
						<span>@invoice.projectInfo.Value.Name</span>
						<span>@invoice.projectInfo.Value.Address</span>
						<span>@($"Steuernummer: {invoice.projectInfo.Value.Steuernummer}")</span>
						<span>@($"USt-IdNr.: {invoice.projectInfo.Value.UStIdNr}")</span>
					</p>
					@for (int i = 0; i < @invoiceService.DownloadedBankTransferDetails.Count; i++)
					{
						<p class="LeftPart">
							<span>@invoiceService.DownloadedBankTransferDetails[i].AccountHolderName</span>
							<span>@invoiceService.DownloadedBankTransferDetails[i].BankName</span>
							<span>@invoiceService.DownloadedBankTransferDetails[i].IBAN</span>
							<span>@invoiceService.DownloadedBankTransferDetails[i].BIC</span>
						</p>
					}
				</div>
			</div>
		</div>
	</div>
}


@code {
	[Parameter]
	public Invoice invoice { get; set; } = null!;
	[Parameter]
	public bool IsInvoiceVisible { get; set; }
	[Parameter]
	public EventCallback OnClose { get; set; }
	private async Task CloseInvoice()
	{
		IsInvoiceVisible = false;
		invoice = null!;
		// remove die invoice von dem vater seite auch
		await OnClose.InvokeAsync();
	}
	
	private async Task OnSaveInvoice(Invoice invoice)
	{
		try
		{

			var bytes = await invoiceService.InvoicePdfGeneration(invoice);

			var base64 = Convert.ToBase64String(bytes);
			var url = $"data:application/pdf;base64,{base64}";

			await JS.InvokeVoidAsync("eval", $@"
                 const byteCharacters = atob('{base64}');
                 const byteNumbers = new Array(byteCharacters.length);
                 for (let i = 0; i < byteCharacters.length; i++) {{
                    byteNumbers[i] = byteCharacters.charCodeAt(i);
                 }}
                 const byteArray = new Uint8Array(byteNumbers);
                 const blob = new Blob([byteArray], {{ type: 'application/pdf' }});
                 const blobUrl = URL.createObjectURL(blob);
                 window.open(blobUrl, '_blank');");

			/* string FileName = $"Rechnung_{invoice.InvoceeNumber}_{invoice.order.Address?.LastName}";
					_ = JS.InvokeVoidAsync("downloadInvoice", "InvoiceBox", FileName);*/
		}
		catch (Exception ex)
		{
			 _ =  JS.InvokeVoidAsync("showAlert", $"Fehler beim Speichern der Rechnung: {ex.Message}");
		}
	}
}
