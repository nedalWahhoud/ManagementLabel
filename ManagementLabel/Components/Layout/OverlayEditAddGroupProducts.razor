<div class="overlay">
	<div class="overlayEditAddForm">
		<h4>@(action == "Add" ? "Gruppe hinzufügen" : "Gruppe bearbeiten")</h4>
		<EditForm Model="@groupProduct" OnValidSubmit="SaveGroup">
			<DataAnnotationsValidator />
			<div class="formGroupAdd">
				<label>Name de</label>
				<InputText class="form-control" @bind-Value="groupProduct.GroupName_de" />
				<ValidationMessage For="@(() => groupProduct.GroupName_de)" />
			</div>
			<div class="formGroupAdd">
				<label>Name ar</label>
				<InputText class="form-control" @bind-Value="groupProduct.GroupName_ar" />
				<ValidationMessage For="@(() => groupProduct.GroupName_ar)" />
			</div>
			<div class="mt-3">
				<button class="btn btn-primary me-2">
					@if (IsProcessing)
					{
						<span class="spinner-border spinner-border-sm"
						role="status"
						aria-hidden="true"></span>
					}
					else
					{
						@(action == "Add" ? "Gruppe hinzufügen" : "Gruppe updaten")
					}
				</button>
				<button class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
			</div>
		</EditForm>
	</div>
</div>

@code {

	[Parameter]
	public GroupProducts groupProduct { get; set; } = new();
	[Parameter]
	public string action { get; set; } = string.Empty;
	[Parameter]
	public EventCallback<string> OnHandel { get; set; }

	private bool IsProcessing = false;
	private async void SaveGroup()
	{
		IsProcessing = true;
		if (action == "Add")
		{
			var result = await productGroupService.CreateGroupProduct(groupProduct);

			if (result.Result)
			{
				groupProduct = null!;
				await OnHandel.InvokeAsync(action);
			}
			else
				await JS.InvokeVoidAsync("showAlert", result.Message);
		}
		else
		{
			GroupProducts? currentGroup = productGroupService.DownloadedproductGroups.FirstOrDefault(c => c.Id == groupProduct.Id);
			if (currentGroup != null)
			{
				bool isEdited = productGroupService.IsCategoryEdited(currentGroup, groupProduct);
				if (isEdited)
				{
					var result = await productGroupService.UpdateGroupProduct(groupProduct);
					if (result.Result)
					{
						groupProduct = new();
						await OnHandel.InvokeAsync(action);
					}
					else
						await JS.InvokeVoidAsync("showAlert", result.Message);
				}
				else
					await JS.InvokeVoidAsync("showAlert", "Nichts hat sich geändert");
			}
			else
				await JS.InvokeVoidAsync("showAlert", "keine currentGroup gefunden");

		}
		IsProcessing = false;
		StateHasChanged();
	}
	private void Cancel()
	{
		groupProduct = new();
		OnHandel.InvokeAsync(action);
	}
}
