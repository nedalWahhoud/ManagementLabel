<div class="overlay">
	<div class="standardOverlayForm">
		<EditForm Model="@customer" OnValidSubmit="Save">
			<DataAnnotationsValidator />
			<div class="overlayField">
				<InputSelect class="form-control" @bind-Value="customer.DistributionLineId">
					<option value="0">Select Verteilungslinie</option>
					@foreach (var distributionLine in distributionLinesService.DownloadedDistributionLines)
					{
						<option value="@distributionLine.Id">@distributionLine.LineName</option>
					}
				</InputSelect>
				<ValidationMessage For="@(() => customer.DistributionLineId)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.Name_de" placeholder="Name de" />
				<ValidationMessage For="@(() => customer.Name_de)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.Name_ar" placeholder="Name ar" />
				<ValidationMessage For="@(() => customer.Name_ar)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.Street" placeholder="Anschrift" />
				<ValidationMessage For="@(() => customer.Street)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.BuildingNumber" placeholder="Hausnummer" />
				<ValidationMessage For="@(() => customer.BuildingNumber)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.PostalCode" placeholder="PLZ" />
				<ValidationMessage For="@(() => customer.PostalCode)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.City" placeholder="Stadt" />
				<ValidationMessage For="@(() => customer.City)" />
			</div>
			<div class="overlayField">
				<div class="input-group">
					<span class="input-group-text customLatIcon">La</span>
				    <InputNumber TValue="double" class="form-control" @bind-Value="customer.Latitude" @onfocus="@(e => SelectAllContent())" />
				</div>
				<ValidationMessage For="@(() => customer.Latitude)" />
			</div>
			<div class="overlayField">
				<div class="input-group">
					<span class="input-group-text customLatIcon">Lo</span>
				    <InputNumber TValue="double" class="form-control" @bind-Value="customer.Longitude" @onfocus="@(e => SelectAllContent())" />
				</div>
				<ValidationMessage For="@(() => customer.Longitude)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.PhoneNumber" placeholder="Tel." />
				<ValidationMessage For="@(() => customer.PhoneNumber)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.Email" placeholder="Email" />
				<ValidationMessage For="@(() => customer.Email)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.Notes_de" placeholder="Notes de" />
				<ValidationMessage For="@(() => customer.Notes_de)" />
			</div>
			<div class="overlayField">
				<InputText class="form-control" @bind-Value="customer.Notes_ar" placeholder="Notes ar" />
				<ValidationMessage For="@(() => customer.Notes_ar)" />
			</div>
			<div class="overlayField">
				<div class="d-flex align-items-center gap-3">
				  <div class="flex-grow-1">
						<InputNumber TValue="int" min="1" class="form-control" @bind-Value="customer.StopNumber" @onfocus="@(e => SelectAllContent())" placeholder="Haltestellennummer" />
				  </div>
				  <div class="form-check">
					<InputCheckbox class="form-check-input" @bind-Value="customer.shouldStopnummerShift" id="shiftCheck" />
					<label class="form-check-label" for="shiftCheck">
					   Sollte verschieben
					</label>
				  </div>
			    </div>
				<ValidationMessage For="@(() => customer.StopNumber)" />
			</div>
			<div class="overlayField">
				<InputText placeholder="PIN Wird Automatisch generiert oder eingeben" maxlength="4" pattern="\d{4}" title="PIN muss genau 4 Zahlen sein" class="form-control" @bind-Value="customer.PIN" />
				<ValidationMessage For="@(() => customer.PIN)" />
			</div>
			<div class="mt-3">
				<button class="btn btn-primary me-2" disabled="@IsProcessing">
					@if (IsProcessing)
					{
						<span class="spinner-border spinner-border-sm"
						role="status"
						aria-hidden="true"></span>
					}
					else
					{
						<span>Speichern</span>
					}
				</button>
				<button class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
			</div>
		</EditForm>
	</div>
</div>

@code {
	[Parameter]
	public Customers customer { get; set; } = new Customers();
	[Parameter]
	public string action { get; set; } = string.Empty;
	[Parameter]
	public EventCallback<string> OnHandel { get; set; }
	private bool IsProcessing = false;
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// scroll spreen
			await JS.InvokeVoidAsync("openFullscreen");
		}
	}
	private async void Save()
	{
		IsProcessing = true;
		if (action == "Add")
		{
			var result = await customersService.AddCustomer(customer);
			if (result.Result)
			{
				// Verteilungslinie zuweisen
				customer.DistributionLine = distributionLinesService.DownloadedDistributionLines
					.Find(dl => dl.Id == customer.DistributionLineId)
					?? await distributionLinesService.GetDistributionLineById(customer.DistributionLineId);

				customer = null!;
				await OnHandel.InvokeAsync(action);
			}
			else
				await JS.InvokeVoidAsync("window.alert", result.Message);
		}
		else
		{
			// wenn category editiert wurde
			Customers? currentCustomer = customersService.DownloadedCustomers.FirstOrDefault(c => c.Id == customer.Id);
			if (currentCustomer != null)
			{
				bool isEdited = customersService.IsEdited(currentCustomer, customer);
				if (isEdited)
				{
					var result = await customersService.UpdateCustomer(customer);
					if (result.Result)
					{
						customer = null!;
						await OnHandel.InvokeAsync(action);
					}
					else
						await JS.InvokeVoidAsync("window.alert", result.Message);
				}
				else
					await JS.InvokeVoidAsync("window.alert", "Nichts hat sich geändert");
			}
			else
				await JS.InvokeVoidAsync("window.alert", "keine currentCategory gefunden");
		}

		IsProcessing = false;
		StateHasChanged();
	}
	private void Cancel()
	{
		customer = new Customers();
		OnHandel.InvokeAsync("Cancel");
	}

	private async Task SelectAllContent()
	{
		try
		{
			// um sicherzustellen, dass der Browser den Fokussierungsprozess abgeschlossen hat
			await Task.Delay(10);
			await JS.InvokeVoidAsync("eval", "document.querySelector('.form-control:focus').select()");
		}
		catch(Exception ex)
		{
			Console.WriteLine($"Fehler beim Auswählen des Inhalts: {ex.Message}");
		}
	}
}
