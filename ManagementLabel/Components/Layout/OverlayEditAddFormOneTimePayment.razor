<div class="overlay">
	<div class="standardOverlayForm">
		@if (!isAddedSuccess)
		{
			@if (Action != "UnexpectedPayment" || UnexpectedPaymentToAdd)
			{
				if (UnexpectedPaymentToAdd && UnexpectedPaymentoneTimePayment != null)
				{
					oneTimePayment = UnexpectedPaymentoneTimePayment;
					Action = "add";
				}
				<EditForm Model="@oneTimePayment" OnValidSubmit="Save">
					<DataAnnotationsValidator />
					<div class="overlayField">
						<InputSelect class="form-control" @bind-Value="oneTimePayment.CustomerId" disabled>
							<option value="@oneTimePayment.CustomerId">@(oneTimePayment.Customer != null ? oneTimePayment.Customer.Name_de + " / " + oneTimePayment.Customer.Name_ar : "Fehler")</option>
						</InputSelect>
						<ValidationMessage For="@(() => oneTimePayment.CustomerId)" />
					</div>
					<div class="overlayField">
						<InputSelect class="form-control" @bind-Value="oneTimePayment.DistributionLineId" disabled>
							<option value="@oneTimePayment.DistributionLineId">@(oneTimePayment.DistributionLine != null ? oneTimePayment.DistributionLine.LineName : "Fehler")</option>
						</InputSelect>
						<ValidationMessage For="@(() => oneTimePayment.DistributionLineId)" />
					</div>
					<div class="overlayField">
						<div class="input-group">
							<span class="input-group-text customLatIcon">G-Betrag</span>
							<InputNumber TValue="double" class="form-control" @bind-Value="oneTimePayment.TotalAmount" @onfocus="@(e => SelectAllContent())" disabled="@(!(Action == "add"))" />
							<span class="input-group-text customLatIcon">€</span>
						</div>
						<ValidationMessage For="@(() => oneTimePayment.TotalAmount)" />
					</div>
					@if (Action == "updateStatus")
					{
						<div class="overlayField">
							<InputSelect class="form-control" @bind-Value="oneTimePayment.Status" disabled>
								<option value="@oneTimePayment.Status">@oneTimePaymentsService.GetEnumDisplayName(oneTimePayment.Status)</option>
							</InputSelect>
							<ValidationMessage For="@(() => oneTimePayment.Status)" />
						</div>
						@if (oneTimePayment.Status != OneTimePaymentStatus.Verschoben)
						{
							<div class="overlayField">
								<div class="input-group">
									<span class="input-group-text customLatIcon">T-Betrag</span>
									<InputNumber TValue="double" class="form-control" @bind-Value="oneTimePayment.AmountCollected" @onfocus="@(e => SelectAllContent())" />
									<span class="input-group-text customLatIcon">€</span>
								</div>
								<ValidationMessage For="@(() => oneTimePayment.AmountCollected)" />
							</div>
						}
					}

					<div class="overlayField">
						<InputText class="form-control" @bind-Value="oneTimePayment.Notes" placeholder="Anmerkungen / ملاحطة" />
						<ValidationMessage For="@(() => oneTimePayment.Notes)" />
					</div>
					<div class="mt-3">
						<button class="btn btn-primary me-2" disabled="@IsProcessing">
							@if (IsProcessing)
							{
								<span class="spinner-border spinner-border-sm"
								role="status"
								aria-hidden="true"></span>
							}
							else
							{
								<span>Speichern</span>
							}
						</button>
						<button class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
					</div>
				</EditForm>
			}
			else
			{
				<div class="UnexpectedPaymentDiv">
					<div class="dropdownListsDiv">
						<select id="distributionLineSelect"
						class="w-full border border-gray-300 bg-white px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
						@bind="selectedDistributionLineId"
						@bind:after="AfterDistributionLineChanged">
							<option value="0" disabled selected class="text-gray-400">Linie wählen...</option>
							@foreach (var distributionLine in distributionLinesService.DownloadedDistributionLines)
							{
								<option value="@distributionLine.Id">@distributionLine.LineName</option>
							}
						</select>
						@if (selectedDistributionLineId == 0)
						{
							<div class="text-sm text-red-500 mt-1">Bitte wählen Sie eine Linie aus.</div>
						}
						else
						{
							if (IsProcessingUnexpectedPayment)
							{
								<div class="text-sm text-blue-500 mt-1 text-primary">
									Lade Kunden...
									<span class="spinner-border spinner-border-sm"
									role="status"
									aria-hidden="true"></span>
								</div>
							}
							else if (customersOfSelectedLine == null)
							{
								<div class="text-sm text-yellow-500 mt-1">Keine Kunden für die ausgewählte Linie gefunden.</div>
							}
							else 
							{
								<select id="stopNumberSelect" class="w-full border border-gray-300 bg-white px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
								@bind="selectedCustomerId"
								@bind:after="AfterCustomerhanged">
									<option value="0">Kunde ausgewählen/ اختر زبون</option>
									@foreach (var customer in customersOfSelectedLine.DistinctBy(c => c.StopNumber).OrderBy(c => c.StopNumber))
									{
										<option value="@customer.Id">@customer.Name_de / @customer.Name_ar</option>
									}
								</select>
							}
						}
					</div>

					<button class="btn btn-secondary" @onclick="Cancel">Abbrechen</button>
				</div>
			}
		}
		else
		{
			<div class="p-4">
				<div class="mb-3 text-success">
					<i class="fa-solid fa-circle-check" style="font-size: 3rem;"></i>
				</div>
				<h4 class="mb-3" style="color: #2e7d32;">Erfolgreich gespeichert!</h4>

				<div class="card text-start mx-auto mb-4" style="max-width: 450px; border-radius: 8px; background-color: #f8f9fa; border-left: 5px solid #2e7d32;">
					<div class="card-body p-3">
						<h6 class="card-title border-bottom pb-2 mb-3 text-secondary fw-bold">
							<i class="fa-solid fa-file-invoice"></i> Details / التفاصيل
						</h6>

						<div class="mb-2 d-flex justify-content-between">
							<span class="text-muted">Kunde / الزبون:</span>
							<span class="fw-bold">
								@(oneTimePayment.Customer != null ? $"{oneTimePayment.Customer.Name_de} / {oneTimePayment.Customer.Name_ar}" : "---")
							</span>
						</div>

						<div class="mb-2 d-flex justify-content-between">
							<span class="text-muted">Linie / الخط:</span>
							<span class="fw-bold">@(oneTimePayment.DistributionLine?.LineName ?? "---")</span>
						</div>

						<div class="mb-2 d-flex justify-content-between">
							<span class="text-muted">Gesamtbetrag / المبلغ الإجمالي:</span>
							<span class="fw-bold text-primary">@oneTimePayment.TotalAmount €</span>
						</div>

						<div class="mb-2 d-flex justify-content-between">
							<span class="text-muted">Status / الحالة:</span>
							<span class="@oneTimePaymentsService.GetStatusClass(oneTimePayment.Status,false)" style="border: none;">
								@oneTimePaymentsService.GetEnumDisplayName(oneTimePayment.Status)
							</span>
						</div>

						@if (!string.IsNullOrEmpty(oneTimePayment.Notes))
						{
							<div class="mt-2 border-top pt-2">
								<small class="text-muted d-block mb-1">Anmerkungen / ملاحظات:</small>
								<div class="p-2 bg-white rounded border small text-wrap text-break">
									@oneTimePayment.Notes
								</div>
							</div>
						}
					</div>
				</div>

				<div class="mt-4">
					<button class="btn btn-success px-5" @onclick="CloseOverlayAfterSuccess">OK</button>
				</div>
			</div>
		}
	</div>
</div>

@code {
	[Parameter]
	public OneTimePayment oneTimePayment { get; set; } = new();
	[Parameter]
	public string Action { get; set; } = string.Empty;
	[Parameter]
	public EventCallback<(string action,OneTimePayment? oneTimePayment)> OnHandel { get; set; }

	private bool IsProcessing = false;
	private bool isAddedSuccess = false;	

	protected async override Task OnInitializedAsync()
	{
		if (Action == "UnexpectedPayment")
		{
			if (distributionLinesService.DownloadedDistributionLines == null || distributionLinesService.DownloadedDistributionLines.Count == 0)
			{
				await distributionLinesService.GetAllDistributionLinesAsync();
			}
		}
	}
	private async Task Save()
	{
		IsProcessing = true;
		if (Action == "add")
		{
			var result = await oneTimePaymentsService.Add(oneTimePayment);
			if (result != null && result.Result)
			{
				isAddedSuccess = true;
			}
			else if (result != null && !result.Result)
				await JS.InvokeVoidAsync("alert", result.Message);
			else
				await JS.InvokeVoidAsync("alert", "Fehler beim Speichern der Einmalzahlung. Bitte überprüfen Sie Ihre Eingaben und versuchen Sie es erneut.");
		}
		else if (Action == "updateStatus")
		{
			var originalPayment = oneTimePaymentsService.GetOneTimePaymentByIdLocal(oneTimePayment.Id) ?? new();
			bool isEdited = oneTimePaymentsService.IsEdited(originalPayment, oneTimePayment);
			if (!isEdited)
			{
				Cancel();
				IsProcessing = false;
				return;
			}

			if (oneTimePayment.Status == OneTimePaymentStatus.TeilweiseInkassiert && (oneTimePayment.AmountCollected == 0 || oneTimePayment.AmountCollected >= oneTimePayment.TotalAmount))
			{
				await JS.InvokeVoidAsync("alert", "Der gesammelte Betrag darf nicht höher, gleich oder 0 sein als der Gesamtbetrag, um den Status auf 'Teilweise Inkassiert' zu setzen.");
				IsProcessing = false;
				return;
			}
			else if (oneTimePayment.Status == OneTimePaymentStatus.Ueberzahlt && oneTimePayment.AmountCollected <= oneTimePayment.TotalAmount)
			{
				await JS.InvokeVoidAsync("alert", "Der gesammelte Betrag muss höher sein als der Gesamtbetrag, um den Status auf 'Überzahlt' zu setzen.");
				IsProcessing = false;
				return;
			}

			var result = await oneTimePaymentsService.UpdateOneTimePaymentAsync(oneTimePayment);
			if (result.Result)
			{
				await OnHandel.InvokeAsync((Action, oneTimePayment));
			}
			else
			{
				await JS.InvokeVoidAsync("alert", result.Message);
			}
		}
		IsProcessing = false;
	}
	private void Cancel()
	{
		OnHandel.InvokeAsync(("cancel",null));
	}
	private async Task CloseOverlayAfterSuccess()
	{
		isAddedSuccess = false;

		if (Action == "add" || UnexpectedPaymentToAdd)
			Action = "UnexpectedPayment";

		await OnHandel.InvokeAsync((Action, oneTimePayment));
	}
	private async Task SelectAllContent()
	{
		try
		{
			// um sicherzustellen, dass der Browser den Fokussierungsprozess abgeschlossen hat
			await Task.Delay(10);
			await JS.InvokeVoidAsync("eval", "document.querySelector('.form-control:focus').select()");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Fehler beim Auswählen des Inhalts: {ex.Message}");
		}
	}

	// UnexpectedPayment
	private int selectedDistributionLineId = 0;
	private List<Customers>? customersOfSelectedLine;
	private bool IsProcessingUnexpectedPayment = false;
	private async Task AfterDistributionLineChanged()
	{
		IsProcessingUnexpectedPayment = true;
		var result = await customersService.GetAllCustomersByLineId(selectedDistributionLineId);
		if (result != null && result.Result)
		{
			customersOfSelectedLine = customersService.DownloadedCustomers.Where(c => c.DistributionLineId == selectedDistributionLineId).ToList();
			StateHasChanged();
		}
		else
		{
			customersOfSelectedLine = null!;
		}
		IsProcessingUnexpectedPayment = false;
	}
	private int selectedCustomerId = 0;
	private bool UnexpectedPaymentToAdd = false;
	private OneTimePayment UnexpectedPaymentoneTimePayment = null!;
	private async Task AfterCustomerhanged()
	{
		UnexpectedPaymentoneTimePayment = new OneTimePayment
			{
				CustomerId = selectedCustomerId,
				Customer = customersService.GetCustomerByIdLocal(selectedCustomerId) 
					?? await customersService.GetCustomerByIdAsync(selectedCustomerId),
				DistributionLineId = selectedDistributionLineId,
				DistributionLine = distributionLinesService.DownloadedDistributionLines.FirstOrDefault(dl => dl.Id == selectedDistributionLineId)
					?? await distributionLinesService.GetDistributionLineById(selectedDistributionLineId)
			};
		UnexpectedPaymentToAdd = true;
		StateHasChanged();
	}
}
