<ul class="dropdown-menu customDropdown dropdown-menu-end">
	@if (!IsDebtPage)
	{
		<li>
			<a class="@(Permissions.IsDebtManage  ? "dropdown-item" : "disabledItem")" @onclick="@(Permissions.IsDebtManage ? EventCallback.Factory.Create<MouseEventArgs>(this, () => OnDebts(customer.Id))  : default!)">
				<i class="bi bi-cash-stack me-1"></i>
				Schulden
			</a>
		</li>
	}
	<li>
		<a class="dropdown-item" @onclick="() => OnMap(customer)">
			<i class="bi bi-geo-alt me-1"></i>
			Navigieren
		</a>
	</li>
	<li>
		<a class="dropdown-item" @onclick="() => OnPhone(customer)">
			<i class="bi bi-telephone me-1"></i>
			Telefonieren
		</a>
	</li>
	<li>
		<a class="dropdown-item" @onclick="() => OnWhatsAppMessage(customer)">
			<i class="bi bi-chat-dots-fill me-1" style="color: #28a745;"></i>
			WhatsApp-Nachricht
		</a>
	</li>
	<li>
		<a class="dropdown-item" @onclick="() => viaWhatasappShare(customer)">
			<i class="bi bi-whatsapp me-1"></i>
			Teilen über WhatsApp
		</a>
	</li>
	<li>
		<a class="@(Permissions.IsRecordOneTimePayment  ? "dropdown-item" : "disabledItem")" @onclick="@(Permissions.IsRecordOneTimePayment ? EventCallback.Factory.Create<MouseEventArgs>(this, () => RecordOneTimePayment(customer))  : default!)">
			<i class="bi bi-currency-exchange me-1"></i>
			Einmalige Zahlung erfassen
		</a>
	</li>
	@if (!IsDebtPage)
	{
		<li>
			<a class="@(Permissions.IsEdit  ? "dropdown-item" : "disabledItem")" @onclick="@(Permissions.IsEdit ? EventCallback.Factory.Create<MouseEventArgs>(this, () => Edit(customer))  : default!)">
				<i class="bi bi-pencil-square me-1"></i>
				Bearbeiten
			</a>
		</li>
		<li>
			<a class="@(Permissions.IsEdit  ? "dropdown-item" : "disabledItem")" @onclick="@(Permissions.IsEdit ? EventCallback.Factory.Create<MouseEventArgs>(this, () => Delete(customer.Id))  : default!)">
				<i class="bi bi-trash3 me-1"></i>
				Löschen
			</a>
		</li>
	}
</ul>

@code {
	[Parameter]
	public Customers customer { get; set; } = null!;
	[Parameter]
	public List<Customers> FilteredCustomers { get; set; } = null!;
	[Parameter]
	public (bool IsEdit, bool IsDebtManage, bool IsRecordOneTimePayment) Permissions { get; set; } = (false, false, false);
	[Parameter]
	public EventCallback<(string action, CustomerProcess customerProcess, bool IsEditing,OneTimePayment oneTimePayment ,bool IsOneTimePaymentProcessing)> OnHandel { get; set; }

	private bool IsDebtPage = false;
	private CustomerProcess customerProcess = new CustomerProcess();
	protected override void OnInitialized()
	{
		var relativePath = navigationManager.ToBaseRelativePath(navigationManager.Uri);

		if (relativePath.StartsWith("debt", StringComparison.OrdinalIgnoreCase))
		{
			IsDebtPage = true;
		}

		// Setze die CustomerId im CustomerProcess-Objekt
		if (customer != null)
			customerProcess.CustomerId = customer.Id;
	}
	private async Task viaWhatasappShare(Customers customer)
	{
		var result = await whatsAppService.SendCustomerInfo(customer);
		if (!result.Result)
		{
			await JS.InvokeVoidAsync("alert", result.Message);
		}
	}
	private void OnDebts(int customerId)
	{
		navigationManager.NavigateTo($"/debt/{customerId}");
	}
	private async Task OnMap(Customers customer)
	{
		if (customer == null)
			return;

		// Address aufbauen
		var addressParts = new List<string>();

		if (!string.IsNullOrWhiteSpace(customer.Street))
			addressParts.Add(customer.Street);

		if (!string.IsNullOrWhiteSpace(customer.BuildingNumber))
			addressParts.Add(customer.BuildingNumber);

		if (!string.IsNullOrWhiteSpace(customer.PostalCode) ||
			!string.IsNullOrWhiteSpace(customer.City))
			addressParts.Add($"{customer.PostalCode} {customer.City}");

		var fullAddress = string.Join(" ", addressParts).Trim();

		bool hasAddress = !string.IsNullOrWhiteSpace(fullAddress);
		bool hasCoordinates = customer.Latitude != 0 && customer.Longitude != 0;

		if (!hasAddress && !hasCoordinates)
		{
			Console.WriteLine("Keine Adresse oder Koordinaten vorhanden.");
			return;
		}

		await JS.InvokeVoidAsync("mapRedirect.openMap", customer.Latitude, customer.Longitude, hasAddress ? fullAddress : "");
	}
	private async Task OnPhone(Customers customer)
	{
		try
		{
			if (customer == null || string.IsNullOrWhiteSpace(customer.PhoneNumber))
			{
				await JS.InvokeVoidAsync("alert", "Keine Telefonnummer für diesen Kunden vorhanden.");
				return;
			}

			await JS.InvokeVoidAsync("phoneRedirect.openPhoneDialer", customer.PhoneNumber);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error redirecting to phone: {ex.Message}");
		}
	}
	private async Task OnWhatsAppMessage(Customers customer)
	{
		var result = await whatsAppService.SendMassage(customer);
		if (!result.Result)
		{
			await JS.InvokeVoidAsync("alert", result.Message);
		}
	}
	public async Task RecordOneTimePayment(Customers customer)
	{
		var oneTimePayment = new OneTimePayment
			{
				CustomerId = customer.Id,
				Customer = customer,
				DistributionLineId = customer.DistributionLineId,
				DistributionLine = customer?.DistributionLine ??
					(distributionLinesService.DownloadedDistributionLines.FirstOrDefault(dl => dl.Id == customer?.DistributionLineId) ?? await distributionLinesService.GetDistributionLineById(customer?.DistributionLineId ?? 0))
			};
		await OnHandel.InvokeAsync(("oneTimePayment", new(), false, oneTimePayment, true));
	}
	private async Task Delete(int id)
	{
		try
		{
			if (id <= 0)
			{
				await JS.InvokeVoidAsync("alert", "Please select a DistributionLine");
				return;
			}
			customerProcess = new CustomerProcess
				{
					IsProcessing = true,
					CustomerId = id
				};
			await OnHandel.InvokeAsync(("Delete", customerProcess, false,new(), false));
			var resultConfirm = await JS.InvokeAsync<bool>("confirm", $"Möchten Sie das DistributionLine mit der ID {id} wirklich löschen?");
			if (resultConfirm)
			{
				var result = await customersService.DeleteCustomer(id);
				customerProcess.Result = result;
				if (!result.Result)
				{
					await JS.InvokeVoidAsync("alert", result.Message);
				}
				// Remove the deleted customer from the filtered list if it exists
				if (FilteredCustomers != null)
				{
					var customerToRemove = FilteredCustomers.FirstOrDefault(c => c.Id == id);
					if (customerToRemove != null)
					{
						FilteredCustomers.Remove(customerToRemove);
					}
				}
			}
			customerProcess.IsProcessing = false;
			customerProcess.CustomerId = id;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error deleting customer: {ex.Message}");
			customerProcess.IsProcessing = false;
			customerProcess.CustomerId = id;
		}

		await OnHandel.InvokeAsync(("Delete", customerProcess, false,new(), false));
	}
	private async Task Edit(Customers customers)
	{
		var editingCustomer = new Customers
			{
				Id = customers.Id,
				Name_de = customers.Name_de,
				Name_ar = customers.Name_ar,
				Street = customers.Street,
				BuildingNumber = customers.BuildingNumber,
				PostalCode = customers.PostalCode,
				City = customers.City,
				Latitude = customers.Latitude,
				Longitude = customers.Longitude,
				PhoneNumber = customers.PhoneNumber,
				Email = customers.Email,
				Notes_de = customers.Notes_de,
				Notes_ar = customers.Notes_ar,
				DistributionLineId = customers.DistributionLineId,
				DistributionLine = customers.DistributionLine,
				StopNumber = customers.StopNumber,
				PIN = customers.PIN
			};

		await OnHandel.InvokeAsync(("Edit", new CustomerProcess(){EditingCustomer = editingCustomer}, true,new (),false));
	}
}
